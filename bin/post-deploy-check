#!/usr/bin/env bash
# Checks production right after a deploy: is it up, which release is it, and
# do the calls the iPhone and Android apps make at launch still answer.
#
# Usage: bin/post-deploy-check [base_url]   (default https://www.lumenviae.org)
#
# Plain curl, no secrets, read-only GETs. Exits non-zero on the first failure.
# The CI deploy job runs it after `flyctl deploy`; anyone can run it by hand.
# What to do when it fails is in docs/DEPLOY_WATCH.md.
set -euo pipefail

base="${1:-https://www.lumenviae.org}"
attempts="${POST_DEPLOY_ATTEMPTS:-10}"
wait_seconds="${POST_DEPLOY_WAIT:-6}"

# GET a path until it answers 200 with a body containing the expected text,
# or the attempts run out. A machine that has just started can answer 503
# for a few seconds while the database pool fills.
check() {
  local path="$1" expect="$2" body code
  for ((i = 1; i <= attempts; i++)); do
    body="$(curl -sS --max-time 15 -w '\n%{http_code}' "$base$path" 2>&1)" || true
    code="${body##*$'\n'}"
    body="${body%$'\n'*}"
    if [ "$code" = "200" ] && [[ "$body" == *"$expect"* ]]; then
      echo "ok    $path"
      return 0
    fi
    sleep "$wait_seconds"
  done
  echo "FAIL  $path (last status $code)" >&2
  echo "${body:0:300}" >&2
  return 1
}

# Up, the database answers, and the release's version.
check /healthz '"status":"ok"'
version="$(curl -sS --max-time 15 "$base/healthz" | sed -n 's/.*"version":"\([^"]*\)".*/\1/p')"
echo "release version: ${version:-unknown}"

# iPhone app (v1, docs/IOS_API_CONTRACT.md).
check '/api/meditation-sets?category=joyful' '"data"'
check /api/voices '"data"'

# Android app (v2, docs/ANDROID_API.md): the daily document polls.
check /api/v2/rosary-content '"version"'
check /api/v2/prayer-book '"version"'
check /api/v2/consecration '"version"'

echo "post-deploy check passed against $base"

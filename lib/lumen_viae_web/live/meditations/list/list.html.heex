<.admin_page
  active="meditations"
  title="Meditations"
  subtitle="Every passage in the library, and what is still missing from it."
  flash={@flash}
>
  <:actions>
    <.link navigate="/admin/meditations/import" class="admin-btn admin-btn-secondary">
      Import CSV
    </.link>
    <.link navigate="/admin/meditations/new" class="admin-btn admin-btn-primary">
      New meditation
    </.link>
  </:actions>

  <div class="grid gap-3 grid-cols-2 lg:grid-cols-4 mb-5">
    <.metric
      label="Active"
      value={@summary.active}
      hint={"#{@summary.total} in the library"}
      navigate="/admin/meditations"
    />
    <.metric
      label="Missing narration"
      value={@summary.missing_audio}
      tone="caution"
      hint="Active, with no audio file"
      navigate="/admin/meditations?audio=without&status=active"
    />
    <.metric
      label="Not in any set"
      value={@summary.unassigned}
      tone="caution"
      hint="Never reachable in the app"
      navigate="/admin/meditations?set=none"
    />
    <.metric
      label="Archived"
      value={@summary.archived}
      hint="Hidden from every public surface"
      navigate="/admin/meditations?status=archived"
    />
  </div>

  <.filters_panel
    filters={@filters}
    mystery_categories={@mystery_categories}
    mysteries={@mysteries}
    available_authors={@available_authors}
    meditation_sets={@meditation_sets}
    shown_count={length(@filtered_meditations)}
    total_count={@summary.total}
    filtered={filters_applied?(@filters)}
  />
  
<!-- The bulk bar appears only when there is a selection to act on -->
  <div
    :if={MapSet.size(@selected_ids) > 0}
    class="sticky top-[4.5rem] z-10 flex flex-wrap items-center justify-between gap-3 mb-3
           bg-navy text-white rounded-lg px-4 py-2.5 shadow-admin-raised"
  >
    <p class="text-[0.8125rem] font-medium">
      {MapSet.size(@selected_ids)} selected
      <button
        type="button"
        phx-click="clear_selection"
        class="ml-2 text-white/70 hover:text-white underline underline-offset-2"
      >
        Clear
      </button>
    </p>
    <div class="flex flex-wrap items-center gap-2">
      <button
        type="button"
        phx-click="bulk_archive"
        data-confirm={"Archive #{MapSet.size(@selected_ids)} selected meditation(s)? They will be hidden from the public site, along with any set containing them."}
        class="admin-btn admin-btn-secondary"
      >
        Archive
      </button>
      <button type="button" phx-click="bulk_unarchive" class="admin-btn admin-btn-secondary">
        Restore
      </button>
      <button
        type="button"
        phx-click="bulk_delete"
        data-confirm={"Permanently delete #{MapSet.size(@selected_ids)} selected meditation(s)? This cannot be undone, and they will be removed from any sets that contain them. Archiving is usually the safer choice."}
        class="admin-btn admin-btn-danger"
      >
        Delete
      </button>
    </div>
  </div>

  <.panel flush>
    <%= if @filtered_meditations == [] do %>
      <div class="p-4">
        <.empty_state>
          No meditations match these filters. Widen them, or import a new CSV.
        </.empty_state>
      </div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="admin-table">
          <thead>
            <tr>
              <th class="w-8">
                <button
                  type="button"
                  phx-click="select_all_shown"
                  class="text-admin-ink-faint hover:text-navy"
                  title="Select all shown"
                  aria-label="Select all shown"
                >
                  <span class="hero-check-circle size-4 block" aria-hidden="true" />
                </button>
              </th>
              <th>Mystery</th>
              <th>Category</th>
              <th>Attribution</th>
              <th>Sets</th>
              <th>Narration</th>
              <th>Status</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <%= for meditation <- @filtered_meditations do %>
              <.meditation_row
                meditation={meditation}
                expanded={@expanded_meditation_id == meditation.id}
                selected={MapSet.member?(@selected_ids, meditation.id)}
              />
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </.panel>
</.admin_page>

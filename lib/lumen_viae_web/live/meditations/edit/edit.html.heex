<.admin_page
  active="meditations"
  title="Edit meditation"
  subtitle={"#{@meditation.mystery.name} · #{LumenViae.Rosary.Categories.label(@meditation.mystery.category)}"}
  flash={@flash}
  max_width="max-w-3xl"
>
  <:actions>
    <.link navigate={@return_to} class="admin-btn admin-btn-secondary">Back to list</.link>
  </:actions>

  <.callout :if={@meditation.archived_at} tone="caution">
    This meditation is archived: it is hidden from the public site and the app, along with any
    set that contains it. Restore it from the <.link
      navigate="/admin/meditations?status=archived"
      class="underline underline-offset-2"
    >
      archived list
    </.link>.
  </.callout>

  <.callout :if={@meditation.audio_url in [nil, ""] and is_nil(@meditation.archived_at)}>
    No narration yet. The app has nothing to play for this meditation until an audio file is
    generated or an S3 key is set below.
  </.callout>

  <.form for={@edit_form} phx-submit="update_meditation">
    <.panel>
      <div class="space-y-4">
        <.field label="Mystery" required errors={@edit_form[:mystery_id].errors}>
          <select name={@edit_form[:mystery_id].name} required class="admin-input">
            <option
              :for={mystery <- @mysteries}
              value={mystery.id}
              selected={to_string(mystery.id) == to_string(@edit_form[:mystery_id].value)}
            >
              {mystery.name} ({LumenViae.Rosary.Categories.label(mystery.category)})
            </option>
          </select>
        </.field>

        <.field label="Title" hint="Optional." errors={@edit_form[:title].errors}>
          <input
            type="text"
            name={@edit_form[:title].name}
            value={@edit_form[:title].value || ""}
            class="admin-input"
            placeholder="e.g. First Meditation on the Annunciation"
          />
        </.field>

        <.field
          label="Content"
          required
          hint="Paragraph breaks carry through to the narration - keep them."
          errors={@edit_form[:content].errors}
        >
          <textarea
            name={@edit_form[:content].name}
            required
            rows="16"
            class="admin-textarea"
          ><%= @edit_form[:content].value || "" %></textarea>
        </.field>

        <div class="grid md:grid-cols-2 gap-4">
          <.field label="Author" errors={@edit_form[:author].errors}>
            <input
              type="text"
              name={@edit_form[:author].name}
              value={@edit_form[:author].value || ""}
              class="admin-input"
              placeholder="e.g. St. Alphonsus Liguori"
            />
          </.field>

          <.field label="Source" hint="Optional." errors={@edit_form[:source].errors}>
            <input
              type="text"
              name={@edit_form[:source].name}
              value={@edit_form[:source].value || ""}
              class="admin-input"
              placeholder="e.g. The Glories of Mary"
            />
          </.field>
        </div>

        <.field
          label="Audio filename"
          hint="The narration's filename. Each voice's recording lives at voices/<voice>/<filename> in the lumenviae-audio bucket."
          errors={@edit_form[:audio_url].errors}
        >
          <input
            type="text"
            name={@edit_form[:audio_url].name}
            value={@edit_form[:audio_url].value || ""}
            class="admin-input"
            placeholder="e.g. Joyful-Annunciation-1.mp3"
          />
        </.field>
      </div>

      <.form_actions cancel_to={@return_to} cancel_label="Back">
        <button type="submit" class="admin-btn admin-btn-primary">Save changes</button>
      </.form_actions>
    </.panel>
  </.form>
</.admin_page>

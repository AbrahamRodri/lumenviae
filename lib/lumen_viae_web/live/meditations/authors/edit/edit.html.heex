<.admin_page
  active="authors"
  title={@author.name}
  subtitle="Author · their portrait stands in for linked sets with no painting of their own."
  flash={@flash}
  max_width="max-w-5xl"
>
  <:actions>
    <.link navigate="/admin/authors" class="admin-btn admin-btn-secondary">Back to list</.link>
  </:actions>

  <div class="space-y-5">
    <.form for={@edit_form} phx-submit="update_author">
      <.panel title="Author details">
        <.field label="Name" required errors={@edit_form[:name].errors}>
          <input
            type="text"
            name={@edit_form[:name].name}
            value={@edit_form[:name].value || ""}
            required
            class="admin-input"
            placeholder="e.g. Venerable Fulton J. Sheen"
          />
        </.field>

        <div class="flex justify-end mt-6 pt-4 border-t border-admin-hairline">
          <button type="submit" class="admin-btn admin-btn-primary">Save changes</button>
        </div>
      </.panel>
    </.form>

    <LumenViaeWeb.Components.ArtworkSection.artwork_section
      record={@author}
      intro="The portrait shown for this author's sets when a set has no painting of its own."
      artwork_url={@artwork_url}
      form={@artwork_form}
      upload={@uploads.artwork}
      licenses={@license_options}
      rules={@artwork_rules}
    />
  </div>
</.admin_page>

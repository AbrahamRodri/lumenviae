<.admin_page
  active="authors"
  title="New author"
  subtitle="Create the author, then upload their portrait and link their sets to it."
  flash={@flash}
  max_width="max-w-2xl"
>
  <.form for={@author_form} phx-submit="create_author">
    <.panel>
      <.field
        label="Name"
        required
        hint="Written the way it appears in bylines, title and all."
        errors={@author_form[:name].errors}
      >
        <input
          type="text"
          name={@author_form[:name].name}
          value={@author_form[:name].value || ""}
          required
          class="admin-input"
          placeholder="e.g. Venerable Fulton J. Sheen"
        />
      </.field>

      <.form_actions cancel_to="/admin/authors">
        <button type="submit" class="admin-btn admin-btn-primary">Create author</button>
      </.form_actions>
    </.panel>
  </.form>
</.admin_page>

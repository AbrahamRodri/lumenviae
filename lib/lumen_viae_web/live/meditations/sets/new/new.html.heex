<.admin_page
  active="sets"
  title="New meditation set"
  subtitle="Create the set first, then add its meditations in order on the edit page."
  flash={@flash}
  max_width="max-w-6xl"
>
  <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] items-start">
    <.form for={@meditation_set_form} phx-submit="create_meditation_set">
      <.panel title="Set details">
        <div class="space-y-4">
          <.field label="Name" required>
            <input
              type="text"
              name="name"
              required
              class="admin-input"
              placeholder="e.g. St. Louis de Montfort - Joyful Mysteries"
            />
          </.field>

          <.field
            label="Category"
            required
            hint="Decides how many meditations the set is expected to hold: five, or seven for the Seven Sorrows."
          >
            <select name="category" required class="admin-input">
              <option value="">Select a category</option>
              <option :for={{label, value} <- @mystery_categories} value={value}>{label}</option>
            </select>
          </.field>

          <.field label="Description" hint="Optional. Shown under the set's name in the app.">
            <textarea name="description" rows="3" class="admin-textarea"></textarea>
          </.field>
        </div>

        <.form_actions cancel_to="/admin/meditation-sets">
          <button type="submit" class="admin-btn admin-btn-primary">Create set</button>
        </.form_actions>
      </.panel>
    </.form>

    <% meditations = filtered_meditations(assigns) %>
    <.panel title="Plan the set">
      <LumenViaeWeb.Components.MeditationFilters.meditation_filters
        filter_category={@filter_category}
        filter_author={@filter_author}
        search_query={@search_query}
        available_authors={@available_authors}
        mystery_categories={@mystery_categories}
        filtered_count={length(meditations)}
        description="Browse what is already in the library to decide what this set will hold. You add meditations after the set exists."
      />

      <div class="mt-4">
        <.empty_state :if={meditations == []}>
          No meditations match these filters. Widen them, or import new meditations first.
        </.empty_state>

        <ul
          :if={meditations != []}
          class="divide-y divide-admin-hairline max-h-[26rem] overflow-y-auto -mx-1 px-1"
        >
          <li :for={meditation <- meditations} class="py-2.5">
            <p class="font-medium text-admin-ink">
              {meditation.mystery.name}{if meditation.title, do: " - #{meditation.title}"}
            </p>
            <p class="text-xs text-admin-ink-faint mt-0.5">
              {LumenViae.Rosary.Categories.label(meditation.mystery.category)}<span :if={
                meditation.author
              }>
                · {meditation.author}</span>
            </p>
            <p :if={meditation.content} class="text-xs text-admin-ink-soft mt-1">
              {content_snippet(meditation.content)}
            </p>
          </li>
        </ul>
      </div>
    </.panel>
  </div>
</.admin_page>

<.admin_page
  active="sets"
  title={@meditation_set.name}
  subtitle={"Meditation set · #{LumenViae.Rosary.Categories.label(@meditation_set.category)}"}
  flash={@flash}
  max_width="max-w-6xl"
>
  <:actions>
    <.link
      navigate={"/meditation-sets/#{@meditation_set.id}/pray"}
      class="admin-btn admin-btn-secondary"
    >
      Preview
    </.link>
    <.link navigate="/admin/meditation-sets" class="admin-btn admin-btn-secondary">
      Back to list
    </.link>
  </:actions>

  <.callout :if={Enum.any?(@selected_set_meditations, & &1.archived_at)} tone="danger">
    This set contains an archived meditation, so neither the public site nor the app will show
    it. Restore the meditation or remove it from the set to bring the set back.
  </.callout>

  <div class="grid gap-5 xl:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] items-start">
    <div class="space-y-5">
      <.form for={@edit_form} phx-submit="update_meditation_set">
        <.panel title="Set details">
          <div class="space-y-4">
            <.field label="Name" required errors={@edit_form[:name].errors}>
              <input
                type="text"
                name={@edit_form[:name].name}
                value={@edit_form[:name].value || ""}
                required
                class="admin-input"
              />
            </.field>

            <.field label="Category" required errors={@edit_form[:category].errors}>
              <select name={@edit_form[:category].name} required class="admin-input">
                <option
                  :for={{label, value} <- @mystery_categories}
                  value={value}
                  selected={@edit_form[:category].value == value}
                >
                  {label}
                </option>
              </select>
            </.field>

            <.field
              label="Description"
              hint="Optional. Shown under the set's name in the app."
              errors={@edit_form[:description].errors}
            >
              <textarea
                name={@edit_form[:description].name}
                rows="3"
                class="admin-textarea"
              ><%= @edit_form[:description].value || "" %></textarea>
            </.field>

            <.field
              label="Linked author"
              hint="When this set has no painting of its own, the app shows this author's portrait instead."
              errors={@edit_form[:author_id].errors}
            >
              <select name={@edit_form[:author_id].name} class="admin-input">
                <option value="">None</option>
                <option
                  :for={author <- @authors}
                  value={author.id}
                  selected={to_string(@edit_form[:author_id].value) == to_string(author.id)}
                >
                  {author.name}
                </option>
              </select>
            </.field>

            <div class="grid md:grid-cols-2 gap-4">
              <.field
                label="Byline"
                hint="Leave blank and it is taken from the meditations, but only when every one of them agrees."
                errors={@edit_form[:author].errors}
              >
                <input
                  type="text"
                  name={@edit_form[:author].name}
                  value={@edit_form[:author].value || ""}
                  class="admin-input"
                  placeholder="e.g. Bl. Anne Catherine Emmerich"
                />
              </.field>

              <.field label="Source" errors={@edit_form[:source].errors}>
                <input
                  type="text"
                  name={@edit_form[:source].name}
                  value={@edit_form[:source].value || ""}
                  class="admin-input"
                  placeholder="e.g. The Dolorous Passion of Our Lord Jesus Christ"
                />
              </.field>
            </div>
          </div>

          <div class="flex justify-end mt-6 pt-4 border-t border-admin-hairline">
            <button type="submit" class="admin-btn admin-btn-primary">Save changes</button>
          </div>
        </.panel>
      </.form>

      <LumenViaeWeb.Live.Meditations.Sets.Edit.LabelsSection.labels_section
        labels={@meditation_set.labels}
        vocabulary={@label_vocabulary}
        max_labels={@max_labels}
      />
    </div>

    <div class="space-y-5">
      <.panel
        title={"Meditations in this set (#{length(@selected_set_meditations)} of #{LumenViae.Rosary.expected_meditation_count(@meditation_set.category)})"}
        description="Prayed in this order."
      >
        <.empty_state :if={@selected_set_meditations == []}>
          No meditations in this set yet. Add some below.
        </.empty_state>

        <ol :if={@selected_set_meditations != []} class="divide-y divide-admin-hairline">
          <li
            :for={{meditation, position} <- Enum.with_index(@selected_set_meditations, 1)}
            class="flex items-center justify-between gap-3 py-2"
          >
            <div class="flex items-baseline gap-2 min-w-0">
              <span class="text-admin-ink-faint text-xs w-4 text-right shrink-0">{position}</span>
              <div class="min-w-0">
                <p class="text-admin-ink truncate">
                  {meditation.mystery.name}{if meditation.title, do: " - #{meditation.title}"}
                </p>
                <div class="flex flex-wrap items-center gap-1.5 mt-0.5">
                  <span :if={meditation.author} class="text-xs text-admin-ink-faint">
                    {meditation.author}
                  </span>
                  <.admin_badge :if={meditation.archived_at} tone="red">Archived</.admin_badge>
                  <.admin_badge :if={meditation.audio_url in [nil, ""]} tone="amber">
                    No audio
                  </.admin_badge>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-1 shrink-0">
              <.link
                navigate={"/admin/meditations/#{meditation.id}/edit?return_to=/admin/meditation-sets/#{@meditation_set.id}/edit"}
                class="admin-btn admin-btn-secondary"
              >
                Edit
              </.link>
              <button
                type="button"
                phx-click="remove_from_set"
                phx-value-meditation_id={meditation.id}
                class="admin-btn admin-btn-danger"
                aria-label="Remove from set"
              >
                <span class="hero-x-mark size-3.5" aria-hidden="true" />
              </button>
            </div>
          </li>
        </ol>
      </.panel>

      <% meditations = filtered_meditations(assigns) %>
      <.panel title="Add a meditation">
        <LumenViaeWeb.Components.MeditationFilters.meditation_filters
          filter_category={@filter_category}
          filter_author={@filter_author}
          search_query={@search_query}
          available_authors={@available_authors}
          mystery_categories={@mystery_categories}
          filtered_count={length(meditations)}
        />

        <.empty_state :if={meditations == []} class="mt-4">
          No meditations match these filters. Widen them, or import new meditations first.
        </.empty_state>

        <.form :if={meditations != []} for={%{}} phx-submit="add_to_set" class="mt-4">
          <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_6rem_auto] items-end">
            <.field label="Meditation" required>
              <select name="meditation_id" required class="admin-input">
                <option value="">Select a meditation</option>
                <option :for={meditation <- meditations} value={meditation.id}>
                  {meditation.mystery.name}{if meditation.title,
                    do: " - #{meditation.title}"}{if meditation.author,
                    do: " (#{meditation.author})"}{if meditation.archived_at,
                    do: " [Archived - adding it hides this set]"}
                </option>
              </select>
            </.field>

            <.field label="Order" required>
              <input
                type="number"
                name="order"
                required
                min="1"
                max="7"
                value={length(@selected_set_meditations) + 1}
                class="admin-input"
              />
            </.field>

            <button type="submit" class="admin-btn admin-btn-primary">Add</button>
          </div>
        </.form>
      </.panel>

      <LumenViaeWeb.Components.ArtworkSection.artwork_section
        record={@meditation_set}
        intro="The painting behind the set on the app's detail screen."
        artwork_url={@artwork_url}
        form={@artwork_form}
        upload={@uploads.artwork}
        licenses={@license_options}
        rules={@artwork_rules}
      />
    </div>
  </div>
</.admin_page>

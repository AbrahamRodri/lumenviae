<.admin_page
  active="sets"
  title="Meditation Sets"
  subtitle="Curated collections shown in the app and on the public site."
  flash={@flash}
>
  <:actions>
    <.link navigate="/admin/meditation-sets/new" class="admin-btn admin-btn-primary">
      New set
    </.link>
  </:actions>

  <div class="grid gap-3 grid-cols-2 lg:grid-cols-5 mb-5">
    <.metric
      label="Live sets"
      value={@summary.live}
      hint={"#{@summary.total} in the library"}
      navigate="/admin/meditation-sets"
    />
    <.metric
      label="Incomplete"
      value={@summary.incomplete}
      tone="caution"
      hint="Wrong meditation count"
      navigate="/admin/meditation-sets?completeness=incomplete"
    />
    <.metric
      label="No artwork"
      value={@summary.no_artwork}
      tone="caution"
      hint="No painting or portrait"
      navigate="/admin/meditation-sets?artwork=missing"
    />
    <.metric
      label="No labels"
      value={@summary.no_labels}
      tone="caution"
      hint="Filed under More in the app"
      navigate="/admin/meditation-sets?label=none"
    />
    <.metric
      label="Hidden"
      value={@summary.hidden}
      hint="Contain archived meditations"
      navigate="/admin/meditation-sets?visibility=hidden"
    />
  </div>

  <.panel class="mb-5">
    <.form for={%{}} phx-change="update_filters">
      <div class="grid gap-3 grid-cols-2 md:grid-cols-4 xl:grid-cols-7">
        <.filter_search
          name="q"
          label="Search"
          value={@filters.query}
          placeholder="Name, byline, or label"
        />
        <.filter_select
          name="category"
          label="Category"
          value={@filters.category}
          prompt="All"
          options={@mystery_categories}
        />
        <.filter_select
          name="label"
          label="Label"
          value={@filters.label}
          prompt="All"
          options={[{"No labels", "none"}] ++ Enum.map(@label_vocabulary, &{&1, &1})}
        />
        <.filter_select
          name="visibility"
          label="Visibility"
          value={@filters.visibility}
          options={[
            {"Live only", "visible"},
            {"Hidden only", "hidden"},
            {"Live and hidden", "all"}
          ]}
        />
        <.filter_select
          name="completeness"
          label="Completeness"
          value={@filters.completeness}
          prompt="Any"
          options={[
            {"Complete", "complete"},
            {"Incomplete", "incomplete"},
            {"Empty", "empty"}
          ]}
        />
        <.filter_select
          name="artwork"
          label="Artwork"
          value={@filters.artwork}
          prompt="Any"
          options={[
            {"Served", "served"},
            {"Uploaded, not served", "unpublishable"},
            {"None", "missing"}
          ]}
        />
        <.filter_select
          name="sort"
          label="Sort"
          value={@filters.sort}
          options={[
            {"Category order", "category"},
            {"Name (A-Z)", "name"},
            {"Newest first", "newest"},
            {"Most meditations", "meditations"}
          ]}
        />
      </div>
    </.form>

    <.filter_summary
      shown={length(@filtered_sets)}
      total={@summary.total}
      noun="sets"
      filtered={filters_applied?(@filters)}
    />
  </.panel>

  <.panel flush>
    <%= if @filtered_sets == [] do %>
      <div class="p-4">
        <.empty_state>
          No meditation sets match these filters. Widen them, or create a new set.
        </.empty_state>
      </div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Set</th>
              <th>Category</th>
              <th>Meditations</th>
              <th>Narrated</th>
              <th>Artwork</th>
              <th>Labels</th>
              <th>Byline</th>
              <th>Status</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <%= for set <- @filtered_sets do %>
              <.set_row
                set={set}
                stats={@set_stats}
                hidden={MapSet.member?(@hidden_set_ids, set.id)}
                expanded={@expanded_set_id == set.id}
                expanded_meditations={
                  if @expanded_set_id == set.id, do: @expanded_meditations, else: []
                }
              />
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </.panel>
</.admin_page>

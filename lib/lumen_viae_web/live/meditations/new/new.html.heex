<.admin_page
  active="meditations"
  title="New meditation"
  subtitle="One passage, attached to one mystery. Narration is generated separately."
  flash={@flash}
  max_width="max-w-3xl"
>
  <.panel title="Mystery" description="Narrow the list below to one category first, if it helps.">
    <.form for={%{}} phx-change="filter_category">
      <.filter_select
        name="category"
        label="Filter by category"
        value={@filter_category}
        prompt="All categories"
        options={LumenViae.Rosary.Categories.options()}
      />
    </.form>
  </.panel>

  <.form for={@meditation_form} phx-submit="create_meditation" class="mt-5">
    <.panel>
      <div class="space-y-4">
        <.field label="Mystery" required>
          <select name="mystery_id" required class="admin-input">
            <option value="">Select a mystery</option>
            <option :for={mystery <- filtered_mysteries(assigns)} value={mystery.id}>
              {mystery.name} ({LumenViae.Rosary.Categories.label(mystery.category)})
            </option>
          </select>
        </.field>

        <.field label="Title" hint="Optional. Shown above the passage in the app.">
          <input
            type="text"
            name="title"
            class="admin-input"
            placeholder="e.g. First Meditation on the Annunciation"
          />
        </.field>

        <.field
          label="Content"
          required
          hint="Paste the passage with its paragraph breaks intact - they carry through to the narration."
        >
          <textarea name="content" required rows="14" class="admin-textarea"></textarea>
        </.field>

        <div class="grid md:grid-cols-2 gap-4">
          <.field label="Author">
            <input
              type="text"
              name="author"
              class="admin-input"
              placeholder="e.g. St. Alphonsus Liguori"
            />
          </.field>

          <.field label="Source" hint="Optional.">
            <input
              type="text"
              name="source"
              class="admin-input"
              placeholder="e.g. The Glories of Mary"
            />
          </.field>
        </div>

        <.field
          label="Audio filename"
          hint="Optional. The narration's filename; each voice's recording lives at voices/<voice>/<filename> in the lumenviae-audio bucket."
        >
          <input
            type="text"
            name="audio_url"
            class="admin-input"
            placeholder="e.g. Joyful-Annunciation-1.mp3"
          />
        </.field>
      </div>

      <.form_actions cancel_to="/admin/meditations">
        <button type="submit" class="admin-btn admin-btn-primary">Create meditation</button>
      </.form_actions>
    </.panel>
  </.form>
</.admin_page>

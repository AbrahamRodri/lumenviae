<.admin_page
  active="meditations"
  title="New meditation"
  subtitle="One passage, attached to one mystery. Narration is generated separately."
  flash={@flash}
  max_width="max-w-3xl"
>
  <.panel title="Mystery" description="Narrow the list below to one category first, if it helps.">
    <.form for={%{}} id="mystery-category-filter" phx-change="filter_category">
      <.filter_select
        name="category"
        label="Filter by category"
        value={@filter_category}
        prompt="All categories"
        options={LumenViae.Rosary.Categories.options()}
      />
    </.form>
  </.panel>

  <.form for={@meditation_form} phx-submit="create_meditation" class="mt-5">
    <.panel>
      <div class="space-y-4">
        <.field label="Mystery" required errors={@meditation_form[:mystery_id].errors}>
          <select name={@meditation_form[:mystery_id].name} required class="admin-input">
            <option value="">Select a mystery</option>
            <option
              :for={mystery <- filtered_mysteries(assigns)}
              value={mystery.id}
              selected={to_string(mystery.id) == to_string(@meditation_form[:mystery_id].value)}
            >
              {mystery.name} ({LumenViae.Rosary.Categories.label(mystery.category)})
            </option>
          </select>
        </.field>

        <.field
          label="Title"
          hint="Optional. Shown above the passage in the app."
          errors={@meditation_form[:title].errors}
        >
          <input
            type="text"
            name={@meditation_form[:title].name}
            value={@meditation_form[:title].value || ""}
            class="admin-input"
            placeholder="e.g. First Meditation on the Annunciation"
          />
        </.field>

        <.field
          label="Content"
          required
          hint="Paste the passage with its paragraph breaks intact - they carry through to the narration."
          errors={@meditation_form[:content].errors}
        >
          <textarea
            name={@meditation_form[:content].name}
            required
            rows="14"
            class="admin-textarea"
          ><%= @meditation_form[:content].value || "" %></textarea>
        </.field>

        <div class="grid md:grid-cols-2 gap-4">
          <.field label="Author" errors={@meditation_form[:author].errors}>
            <input
              type="text"
              name={@meditation_form[:author].name}
              value={@meditation_form[:author].value || ""}
              class="admin-input"
              placeholder="e.g. St. Alphonsus Liguori"
            />
          </.field>

          <.field label="Source" hint="Optional." errors={@meditation_form[:source].errors}>
            <input
              type="text"
              name={@meditation_form[:source].name}
              value={@meditation_form[:source].value || ""}
              class="admin-input"
              placeholder="e.g. The Glories of Mary"
            />
          </.field>
        </div>

        <.field
          label="Audio filename"
          hint="Optional. The narration's filename; each voice's recording lives at voices/<voice>/<filename> in the lumenviae-audio bucket."
          errors={@meditation_form[:audio_url].errors}
        >
          <input
            type="text"
            name={@meditation_form[:audio_url].name}
            value={@meditation_form[:audio_url].value || ""}
            class="admin-input"
            placeholder="e.g. Joyful-Annunciation-1.mp3"
          />
        </.field>
      </div>

      <.form_actions cancel_to="/admin/meditations">
        <button type="submit" class="admin-btn admin-btn-primary">Create meditation</button>
      </.form_actions>
    </.panel>
  </.form>
</.admin_page>

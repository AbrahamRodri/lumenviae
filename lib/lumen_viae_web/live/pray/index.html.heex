<div
  id="prayer"
  class="prayer-surface relative min-h-[100dvh] bg-navy text-cream flex flex-col"
  phx-hook="PrayerSurface"
  data-count={@count}
>
  <div class="absolute inset-0 opacity-[0.04] pointer-events-none" aria-hidden="true">
    <img src="/images/ornate-blue-gold-bg-symbols.jpg" alt="" class="w-full h-full object-cover" />
  </div>

  <div class="prayer-safe-area relative flex-1 flex flex-col w-full max-w-3xl mx-auto">
    <header class="flex items-center gap-2 pt-3">
      <.link
        navigate={~p"/mysteries/#{@category}"}
        class="flex items-center justify-center w-11 h-11 shrink-0 rounded-full text-gold-light/70 hover:text-gold focus-visible:outline-2 focus-visible:outline-gold"
        aria-label="Leave the prayer and return to the mysteries"
      >
        <span class="hero-x-mark size-5" aria-hidden="true" />
      </.link>

      <h1 class="flex-1 min-w-0 text-center font-cinzel text-base md:text-lg text-gold leading-snug">
        {@heading}
      </h1>

      <button
        :if={!@completed}
        type="button"
        phx-click="toggle_panel"
        aria-expanded={to_string(@panel_open)}
        aria-controls="prayer-settings"
        aria-label="How to pray"
        class={[
          "flex items-center justify-center w-11 h-11 shrink-0 rounded-full hover:text-gold focus-visible:outline-2 focus-visible:outline-gold",
          if(@panel_open, do: "text-gold bg-gold/15", else: "text-gold-light/70")
        ]}
      >
        <span class="hero-adjustments-horizontal size-5" aria-hidden="true" />
      </button>
      <span :if={@completed} class="w-11 shrink-0" aria-hidden="true"></span>
    </header>

    <%= if @completed do %>
      <Completion.completion category={@category} storage_key={@storage_key} />
    <% else %>
      <Controls.settings_panel
        :if={@panel_open}
        route={@route}
        form={@form}
        count={@count}
        extras={@extras}
        chaplet={@sequence.chaplet?}
      />

      <Controls.resume_banner :if={@resume} resume={@resume} />

      <div class="mt-3">
        <Strand.progress sequence={@sequence} page={@page} />
      </div>

      <div class="mt-3">
        <Controls.aloud_controls voices={@voices} voice={@voice} pray_aloud={@pray_aloud} />
      </div>

      <Controls.spoken_player
        :if={@pray_aloud}
        id={spoken_id(assigns)}
        script={@spoken_script}
        start_screen={current_screen(assigns).index}
        title={@heading}
      />

      <main id="prayer-main" class="flex-1 pt-8 pb-6">
        <%= if @count == "screen" do %>
          <BeadScreen.bead_screen
            sequence={@sequence}
            screen={current_screen(assigns)}
            audio_url={current_audio_url(assigns)}
            pray_aloud={@pray_aloud}
            show_meditation={@show_meditation}
          />
        <% else %>
          <PageView.page_view
            sequence={@sequence}
            page={Sequence.page(@sequence, @page)}
            audio_url={current_audio_url(assigns)}
            pray_aloud={@pray_aloud}
            show_meditation={@show_meditation}
          />
        <% end %>
      </main>

      <Controls.bottom_nav
        count={@count}
        at_start={@page == 0 and @step == 0}
        at_end={at_end?(assigns)}
      />

      <div
        id="prayer-memory"
        phx-hook="PrayerMemory"
        hidden
        data-key={"#{@storage_key}:#{@form}"}
        data-mystery={Params.mystery_param(@page, length(@decades))}
        data-step={@step}
        data-count={@count}
        data-extras={Enum.join(@extras, ",")}
      >
      </div>
    <% end %>
  </div>
</div>

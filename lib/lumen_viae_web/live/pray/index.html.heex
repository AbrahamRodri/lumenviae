<div
  id="prayer"
  class="prayer-surface relative min-h-[100dvh] text-ink-light flex flex-col"
  phx-hook="PrayerSurface"
  data-layout="focused"
  data-hides-chant-player
  data-count="screen"
>
  <%!-- The app's candle: a warm glow from the top of the page. --%>
  <div class="prayer-glow absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none" aria-hidden="true">
    <picture>
      <source
        type="image/webp"
        srcset="/images/ornate-blue-gold-bg-symbols-480.webp 480w, /images/ornate-blue-gold-bg-symbols-735.webp 735w"
        sizes="100vw"
      />
      <img
        src="/images/ornate-blue-gold-bg-symbols.jpg"
        alt=""
        class="w-full h-full object-cover"
      />
    </picture>
  </div>

  <Layouts.flash_group flash={@flash} variant={:public} />

  <div class="prayer-safe-area relative flex-1 flex flex-col w-full max-w-3xl mx-auto">
    <%!-- One bar, as the app's: close, where you are, and the controls.
         The pill sits in the middle column, so it stays centred whatever
         the sides hold. --%>
    <header class="prayer-top-bar grid grid-cols-[1fr_auto_1fr] items-start gap-2 sm:gap-4 pt-3">
      <h1 class="sr-only">{@heading}</h1>
      <.link
        navigate={~p"/mysteries/#{@category}"}
        class="flex items-center justify-center w-11 h-11 shrink-0 rounded-full bg-ink-light/7 text-ink-light hover:text-gilt"
        aria-label="Leave the prayer and return to the mysteries"
      >
        <span class="hero-x-mark size-5" aria-hidden="true" />
      </.link>

      <div class="min-w-0">
        <Strand.where :if={!@completed} sequence={@sequence} page={@page} open={@go_to_open} />
      </div>

      <%!-- Mute alone on the right, as in the app; How to pray sits under
           the controls row. The spacer keeps the pill centred without it. --%>
      <div class="justify-self-end">
        <Controls.mute_button :if={!@completed and @spoken_script != []} />
        <span :if={@completed or @spoken_script == []} class="block w-11" aria-hidden="true"></span>
      </div>
    </header>

    <%= if @completed do %>
      <Completion.completion category={@category} storage_key={@storage_key} />
    <% else %>
      <Controls.settings_panel
        :if={@panel_open}
        heading={@heading}
        subheading={if @route == :set, do: "The " <> Categories.devotion_title(@category)}
        route={@route}
        form={@form}
        extras={@extras}
        chaplet={@sequence.chaplet?}
        language={@language}
        voices={@voices}
        voice={@voice}
      />

      <Controls.resume_banner :if={@resume} resume={@resume} />

      <Strand.go_to_list
        :if={@go_to_open}
        sequence={@sequence}
        page={@page}
        heading={@heading}
      />

      <div id="prayer-main" class="flex-1 pt-5 pb-6">
        <BeadScreen.bead_screen
          sequence={@sequence}
          screen={current_screen(assigns)}
          timings={current_timings(assigns)}
          show_meditation={@show_meditation}
          language={@language}
        />
      </div>

      <Controls.swipe_hint :if={@spoken_script == []} place={"#{@page}-#{@step}"} />

      <Controls.bottom_nav
        at_start={@page == 0 and @step == 0}
        at_end={at_end?(assigns)}
        panel_open={@panel_open}
      >
        <:play :if={@spoken_script != []}>
          <Controls.spoken_play
            id={spoken_id(assigns)}
            script={@spoken_script}
            start_screen={current_screen(assigns).index}
            title={@heading}
          />
        </:play>
      </Controls.bottom_nav>

      <div
        id="prayer-memory"
        phx-hook="PrayerMemory"
        hidden
        data-key={"#{@storage_key}:#{@form}"}
        data-mystery={Params.mystery_param(@page, length(@decades))}
        data-step={@step}
        data-count="screen"
        data-extras={Enum.join(@extras, ",")}
        data-language={@language}
      >
      </div>
    <% end %>
  </div>
</div>

<div class="hours-page min-h-screen pb-16" id="hours-calendar" phx-hook="UserTimezone">
  <Layouts.flash_group flash={@flash} variant={:public} />

  <section class="max-w-5xl mx-auto px-4 sm:px-8 pt-6 md:pt-10" aria-labelledby="calendar-heading">
    <.link navigate="/hours" class="btn-text !text-ink-muted hover:!text-gilt-light -ml-1">
      <span class="hero-chevron-left size-3.5" aria-hidden="true" /> Hours of Prayer
    </.link>

    <div class="hours-month-head mt-4">
      <.link
        :if={@previous}
        patch={@previous}
        class="hours-month-step"
        aria-label="Previous month"
        data-role="previous-month"
      >
        <span class="hero-chevron-left size-4" aria-hidden="true" />
      </.link>
      <span :if={!@previous} class="hours-month-step" aria-hidden="true"></span>
      <h1 id="calendar-heading" class="hours-month-title">{@title}</h1>
      <.link
        :if={@next}
        patch={@next}
        class="hours-month-step"
        aria-label="Next month"
        data-role="next-month"
      >
        <span class="hero-chevron-right size-4" aria-hidden="true" />
      </.link>
      <span :if={!@next} class="hours-month-step" aria-hidden="true"></span>
    </div>
    <.sacred_divider class="!my-4 max-w-[160px] mx-auto" />

    <p :if={@state == :loading} class="sr-only" aria-live="polite">Loading the month</p>
    <div
      :if={@state == :failed}
      class="text-center mb-4"
      role="alert"
      data-role="calendar-failed"
    >
      <p class="hours-quiet">{@title} could not be reached. Every day still opens.</p>
      <button type="button" phx-click="retry" class="btn-text" data-role="retry">
        <span class="hero-arrow-path size-3.5" aria-hidden="true" /> Try again
      </button>
    </div>

    <div class="hours-month" data-role="month">
      <div class="hours-month__week" aria-hidden="true">
        <span :for={letter <- @weekdays} class="hours-month__weekday">
          {letter}
        </span>
      </div>
      <div
        :for={week <- Enum.chunk_every(@cells, 7)}
        class="hours-month__week"
      >
        <span :for={date <- week} class="min-w-0">
          <.link
            :if={date}
            navigate={CanonicalHours.day_path(date)}
            class="hours-day"
            aria-current={if(date == @today, do: "date")}
            aria-label={spoken(date, @days[date])}
            data-role="day-cell"
            data-date={Date.to_iso8601(date)}
          >
            <span class="hours-day__number">{date.day}</span>
            <span
              class={[
                "hours-day__mark",
                mark(@days[date]) && "hours-day__mark--#{mark(@days[date])}"
              ]}
              aria-hidden="true"
            ></span>
            <span :if={day_title(@days[date])} class="hours-day__title" aria-hidden="true">
              {day_title(@days[date])}
            </span>
          </.link>
        </span>
      </div>
    </div>

    <div
      :if={@today.year == @year and @today.month == @month and @days[@today]}
      class="hours-today-line md:hidden"
      data-role="today-line"
    >
      <p class="kicker !text-[0.75rem] opacity-80">{CanonicalHours.long_date(@today)}</p>
      <p class="hours-feast !text-lg" lang="la">{day_title(@days[@today])}</p>
      <p :if={class_line(@days[@today])} class="hours-class">{class_line(@days[@today])}</p>
    </div>

    <p class="hours-credit mt-10">{CanonicalHours.credit()}</p>
  </section>
</div>

<div
  class="sr-page min-h-screen pb-16"
  id="spiritual-reading-book"
  phx-hook="SpiritualReadingPlace"
  data-page="book"
  data-book={@book.id}
  data-edition={assigns[:edition]}
  data-book-screen={@book.id}
>
  <Layouts.flash_group flash={@flash} variant={:public} />

  <div class="mx-auto max-w-5xl px-4 sm:px-8">
    <.link navigate={Shelf.path()} class="book-back mt-4" data-role="back">
      <span class="hero-chevron-left size-4" aria-hidden="true" /> Spiritual Reading
    </.link>

    <div class="td-book sr-book">
      <section class="sr-book__front" aria-labelledby="book-heading">
        <div class="sr-book__head">
          <.cover book={@book} class="sr-cover--book" />
          <div class="sr-book__about">
            <h1 id="book-heading" class="sr-book__title">{@book.title}</h1>
            <p class="sr-book__author">{@book.author}</p>
            <.link
              :if={@state == :ready}
              navigate={Shelf.chapter_path(@book.id, 0)}
              class="btn-gold sr-act"
              id="read-act"
              data-role="read-act"
              aria-label={"Begin reading, #{Shelf.spoken(hd(@chapters))}"}
              phx-update="ignore"
            >
              <span data-role="act-label">Begin reading</span>
              <span class="hero-chevron-right size-4" aria-hidden="true" />
            </.link>
          </div>
        </div>
        <p class="sr-credit sr-credit--wide">
          <.credit book={@book} />
        </p>
      </section>

      <div class="sr-book__body">
        <.loading :if={@state == :loading} />
        <.unavailable :if={@state == :failed} failure={@failure} />

        <div
          :if={@recording}
          id="book-player"
          phx-hook="BookPlayer"
          phx-update="ignore"
          data-page="book"
          data-book={@book.id}
          data-title={@book.title}
          data-rate={@book.preferred_rate}
          data-tracks={Shelf.player_tracks(@recording)}
        >
          <.player book={@book} />
        </div>

        <nav
          :if={@state == :ready}
          class="sr-ledger"
          id={if @recording, do: "contents-listening", else: "contents"}
          aria-labelledby="contents-heading"
          data-role="contents"
          phx-update="ignore"
        >
          <h2 id="contents-heading" class="td-ledger__kicker sr-ledger__kicker">
            Contents · {length(@chapters)} chapters
          </h2>

          <button type="button" class="sr-earlier" data-role="earlier" hidden>
            <span class="hero-chevron-up size-3" aria-hidden="true" />
            <span class="sr-earlier__count" data-role="earlier-count"></span>
            <span class="sr-earlier__show">Show</span>
          </button>

          <div class={["sr-ledger__body", @parts? && "sr-ledger__body--indexed"]}>
            <div class="min-w-0">
              <section
                :for={run <- @runs}
                class="sr-run"
                id={run.number && "part-#{run.number}"}
                data-role="run"
              >
                <h3 :if={@parts? && run.title} class="sr-part">
                  <span class="sr-part__name">{run.title}</span>
                  <span class="sr-part__count">
                    {length(run.chapters)} {if length(run.chapters) == 1,
                      do: "chapter",
                      else: "chapters"}
                  </span>
                </h3>
                <ol class="sr-rows">
                  <li :for={chapter <- run.chapters} class="sr-rows__item" data-role="row-item">
                    <.chapter_row
                      chapter={chapter}
                      book={@book}
                      runs={@runs}
                      numbered?={@numbered?}
                    />
                    <.listen_chip
                      :if={@recording}
                      chapter={chapter}
                      book={@book}
                      recording={@recording}
                    />
                  </li>
                </ol>
              </section>
            </div>

            <nav :if={@parts?} class="sr-index" aria-label="Parts" data-role="part-index">
              <a
                :for={run <- Shelf.titled(@runs)}
                href={"#part-#{run.number}"}
                class="sr-index__part"
                data-part={run.number}
                aria-label={run.title}
              >
                {Shelf.roman(run.number)}
              </a>
            </nav>
          </div>
        </nav>

        <div
          :if={@recording_failed? && @state == :ready}
          class="sr-recording-failed"
          role="status"
          data-role="recording-unavailable"
        >
          <p>The recording couldn't be reached.</p>
          <button
            type="button"
            phx-click="retry_recording"
            class="btn-text"
            data-role="retry-recording"
          >
            <span class="hero-arrow-path size-3.5" aria-hidden="true" /> Try again
          </button>
        </div>

        <p class="sr-credit sr-credit--narrow">
          <.credit book={@book} />
        </p>
      </div>
    </div>
  </div>
</div>

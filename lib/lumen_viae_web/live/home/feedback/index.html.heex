<div class="bg-parchment min-h-screen">
  <!-- Hero -->
  <section class="relative bg-navy overflow-hidden border-b-3 border-gold">
    <div class="absolute inset-0 opacity-[0.05]" aria-hidden="true">
      <img
        src="/images/ornate-blue-gold-bg-symbols.jpg"
        alt=""
        class="w-full h-full object-cover"
      />
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-navy-dark/50 via-transparent to-navy-dark/70"
      aria-hidden="true"
    >
    </div>

    <div class="relative max-w-3xl mx-auto px-8 py-16 text-center">
      <p class="font-cinzel text-xs md:text-sm tracking-[0.3em] uppercase text-gold-light mb-4 animate-rise">
        Feedback
      </p>
      <h1
        class="font-cinzel text-4xl md:text-5xl text-cream mb-5 animate-rise"
        style="animation-delay: 120ms"
      >
        We Would Love to Hear from You
      </h1>
      <.sacred_divider class="max-w-[210px] mx-auto" />
      <p
        class="font-garamond text-xl md:text-2xl text-gold-light italic leading-relaxed animate-rise"
        style="animation-delay: 240ms"
      >
        Share your thoughts, report a bug, or suggest a feature so we can
        continue improving Lumen Viae.
      </p>
    </div>
  </section>
  
<!-- Cards -->
  <div class="max-w-4xl mx-auto px-8 py-16 grid gap-8 md:grid-cols-2">
    <section class="hairline-card p-10 hover:shadow-ornate hover:-translate-y-1 transition-all duration-300 flex flex-col">
      <h2 class="font-cinzel text-2xl text-navy mb-3">Report an Issue</h2>
      <p class="font-garamond text-lg text-brown leading-relaxed mb-8 grow">
        If you notice a typo, broken link, or anything that doesn&apos;t look
        quite right, send a quick note our way.
      </p>
      <a href={@issue_mailto} class="btn-outline-gold text-navy self-start">
        Send an Issue Report
      </a>
    </section>

    <section class="hairline-card p-10 hover:shadow-ornate hover:-translate-y-1 transition-all duration-300 flex flex-col">
      <h2 class="font-cinzel text-2xl text-navy mb-3">Request a Feature</h2>
      <p class="font-garamond text-lg text-brown leading-relaxed mb-8 grow">
        Have an idea that would make the rosary meditations more helpful?
        We welcome your feature suggestions.
      </p>
      <.gold_cta href={@feature_mailto} class="self-start">
        Share a Feature Idea
      </.gold_cta>
    </section>
  </div>
  
<!-- Direct contact -->
  <div class="max-w-3xl mx-auto px-8 pb-20 text-center">
    <div class="flex items-center gap-6 justify-center mb-8">
      <div class="h-px w-16 bg-gold/40"></div>
      <span class="font-cinzel text-xs tracking-[0.35em] uppercase text-gold-dark">
        or write directly
      </span>
      <div class="h-px w-16 bg-gold/40"></div>
    </div>
    <p class="font-garamond text-lg text-brown leading-relaxed">
      You can always reach us at
      <a
        href={"mailto:" <> @contact_email}
        class="font-semibold text-navy underline underline-offset-4 decoration-gold/50 hover:text-gold-dark transition-colors"
      >
        {@contact_email}
      </a>
      for questions, ideas, or general feedback.
    </p>
  </div>
</div>

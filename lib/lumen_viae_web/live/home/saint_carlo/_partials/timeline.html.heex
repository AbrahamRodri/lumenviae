<section id="timeline" class="scroll-mt-8">
  <div class="text-center mb-10">
    <p class="font-cinzel text-xs tracking-[0.35em] uppercase text-gold-dark mb-3">
      1991 &ndash; 2025
    </p>
    <h2 class="font-cinzel text-navy text-4xl md:text-5xl mb-4">
      A Short Life, Fully Given
    </h2>
    <.sacred_divider class="max-w-[150px] mx-auto" />
    <p class="font-garamond text-brown text-xl max-w-2xl mx-auto leading-relaxed">
      Fifteen years on earth, and a road that leads from a London parish to the
      altars of the universal Church. Select each moment of the journey.
    </p>
  </div>

<!-- Moment selector: gold beads on a fine chain line -->
  <div class="relative mb-8">
    <div
      class="hidden md:block absolute inset-x-0 top-1/2 h-px bg-gold/30"
      aria-hidden="true"
    >
    </div>
    <div
      id="moment-tablist"
      phx-hook="Tablist"
      class="relative flex flex-wrap justify-center gap-2"
      role="tablist"
      aria-label="Moments in the life of St. Carlo Acutis"
    >
      <%= for moment <- @moments do %>
        <button
          type="button"
          role="tab"
          id={"moment-tab-#{moment.id}"}
          aria-selected={to_string(moment.id == @selected_moment)}
          aria-controls="moment-panel"
          tabindex={if moment.id == @selected_moment, do: "0", else: "-1"}
          phx-click="select-moment"
          phx-value-moment={moment.id}
          class={[
            "px-4 py-2 rounded-full font-cinzel tracking-wide transition-all duration-300 border text-sm md:text-base",
            if(moment.id == @selected_moment,
              do: "bg-navy text-cream border-gold shadow-md scale-105",
              else: "bg-white text-navy border-gold/30 hover:border-gold hover:bg-cream/60"
            )
          ]}
        >
          <span class={[
            "font-cinzel text-xs tracking-[0.15em] mr-1.5",
            if(moment.id == @selected_moment, do: "text-gold-light", else: "text-gold-dark")
          ]}>
            {moment.year}
          </span>
          {moment.label}
        </button>
      <% end %>
    </div>
  </div>

  <% moment = current_moment(@moments, @selected_moment) %>
  <div
    id="moment-panel"
    role="tabpanel"
    aria-labelledby={"moment-tab-#{@selected_moment}"}
    class="hairline-card p-6 md:p-10 max-w-3xl mx-auto"
  >
    <p class="font-cinzel text-gold-dark text-3xl mb-2">{moment.year}</p>
    <h3 class="font-cinzel text-navy text-2xl md:text-3xl mb-4">
      {moment.title}
    </h3>
    <p class="font-garamond text-brown text-lg md:text-xl leading-relaxed">
      {moment.text}
    </p>
  </div>
</section>

<main class="min-h-screen" id="home-page" phx-hook="UserTimezone">
  <!-- Hero Section -->
  <section
    class="relative bg-navy overflow-hidden border-b-3 border-gold"
    aria-labelledby="home-hero-heading"
  >
    <!-- Ornate background pattern -->
    <div class="absolute inset-0 opacity-[0.05]" aria-hidden="true">
      <img
        src="/images/ornate-blue-gold-bg-symbols.jpg"
        alt=""
        class="w-full h-full object-cover"
      />
    </div>
    <!-- Deep vignette to focus the center -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-navy-dark/60 via-transparent to-navy-dark/80"
      aria-hidden="true"
    >
    </div>

    <div class="relative max-w-5xl mx-auto px-8 pt-16 pb-20 text-center">
      <!-- Halo-lit image of Our Lady -->
      <div class="relative inline-block mb-8 animate-rise">
        <div
          class="bg-halo absolute -inset-10 rounded-full animate-halo"
          aria-hidden="true"
        >
        </div>
        <img
          src="/images/pngs/blessed-mary-with-child-jesus-rustic-cutout.png"
          alt="Blessed Virgin Mary with Child Jesus"
          class="relative w-52 md:w-64 mx-auto drop-shadow-2xl"
        />
      </div>

      <p
        class="font-cinzel text-xs md:text-sm tracking-[0.4em] uppercase text-gold-light mb-5 animate-rise"
        style="animation-delay: 120ms"
      >
        Lumen Viae &middot; The Light of the Way
      </p>

      <h1
        id="home-hero-heading"
        class="font-cinzel text-5xl md:text-7xl text-cream mb-6 animate-rise"
        style="animation-delay: 200ms"
      >
        The Rosary, Illuminated
      </h1>

      <p
        class="font-garamond text-xl md:text-2xl text-gold-light italic max-w-2xl mx-auto leading-relaxed mb-10 animate-rise"
        style="animation-delay: 300ms"
      >
        A journey through the Holy Rosary, guided by the meditations of the saints
        and doctors of the Church, to illuminate the mysteries of Christ.
      </p>

      <div
        class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-14 animate-rise"
        style="animation-delay: 400ms"
      >
        <.gold_cta
          navigate={@recommended_set.path}
          aria-label="Pray today's recommended mystery set"
        >
          Pray Today's Mysteries
        </.gold_cta>
        <.link navigate="/rosary-methods" class="btn-outline-gold text-cream">
          Learn the Methods
        </.link>
      </div>

<!-- Rosary bead week strip -->
      <div class="animate-rise" style="animation-delay: 500ms">
        <div class="relative max-w-md mx-auto">
          <div class="absolute top-[0.4rem] inset-x-8 h-px bg-gold/25" aria-hidden="true"></div>
          <div class="relative flex items-start justify-between px-4">
            <%= for day <- @week do %>
              <div class="flex flex-col items-center gap-2 w-12">
                <span class={["bead", day.today? && "bead-today"]} aria-hidden="true"></span>
                <span class={[
                  "font-cinzel text-[0.65rem] tracking-[0.2em] uppercase",
                  day.today? && "text-gold font-semibold",
                  !day.today? && "text-gold-light/50"
                ]}>
                  {day.label}
                </span>
              </div>
            <% end %>
          </div>
        </div>
        <p class="font-garamond text-base text-gold-light/80 mt-5">
          Today is {Calendar.strftime(@today, "%A")} &mdash;
          <span class="text-gold font-medium">{@recommended_set.title}</span>
        </p>
      </div>
    </div>
  </section>

<!-- Today's Mysteries Feature -->
  <section class="bg-parchment py-20 px-8" aria-labelledby="today-heading">
    <div class="max-w-6xl mx-auto">
      <div class="grid lg:grid-cols-5 gap-12 items-center">
        <!-- The five mysteries of today -->
        <div class="lg:col-span-3">
          <p class="font-cinzel text-xs tracking-[0.35em] uppercase text-gold-dark mb-3">
            {Calendar.strftime(@today, "%A")}'s Devotion
          </p>
          <h2 id="today-heading" class="font-cinzel text-4xl md:text-5xl text-navy mb-6">
            {@recommended_set.title}
          </h2>
          <p class="font-garamond text-xl text-brown leading-relaxed mb-8 max-w-xl">
            {@recommended_set.description}
          </p>

          <ol class="space-y-0 mb-8 border-l border-gold/30">
            <%= for {mystery, index} <- Enum.with_index(@recommended_set.mysteries, 1) do %>
              <li class="group flex items-baseline gap-5 pl-6 py-3 border-b border-gold/15 last:border-b-0 transition-colors">
                <span class="font-cinzel text-gold-dark text-xl w-8 shrink-0">
                  {Enum.at(["I.", "II.", "III.", "IV.", "V."], index - 1)}
                </span>
                <span class="font-garamond text-xl text-navy group-hover:text-navy-light transition-colors">
                  {mystery}
                </span>
              </li>
            <% end %>
          </ol>

          <p class="font-garamond italic text-brown-light mb-8">
            Fruits of these mysteries: {@recommended_set.fruit}.
          </p>

          <.gold_cta navigate={@recommended_set.path}>
            Begin Praying <span aria-hidden="true">&rarr;</span>
          </.gold_cta>
        </div>

<!-- Framed devotional image -->
        <div class="lg:col-span-2 flex justify-center">
          <.arch_frame
            src="/images/pngs/queen-of-heaven-white-bg.jpg"
            alt="Queen of Heaven"
            class="w-64 md:w-80"
          />
        </div>
      </div>
    </div>
  </section>

  <div class="bg-parchment py-6">
    <.sacred_divider class="max-w-[210px] mx-auto my-0" />
  </div>

<!-- Mystery Categories -->
  <section class="bg-parchment pb-20 px-8" aria-labelledby="mystery-heading">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <p class="font-cinzel text-xs tracking-[0.35em] uppercase text-gold-dark mb-3">
          The Fifteen Mysteries
        </p>
        <h2 id="mystery-heading" class="font-cinzel text-4xl md:text-5xl text-navy mb-4">
          Three Paths of Contemplation
        </h2>
        <p class="font-garamond text-xl text-brown max-w-2xl mx-auto">
          Each set carries the meditations of a different saint or spiritual
          master through the life, passion, and glory of Our Lord.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <%= for {_key, set} <- @mystery_sets do %>
          <% recommended? = set.key == @recommended_set_key %>
          <.link
            navigate={set.path}
            class={[
              "group relative block bg-white overflow-hidden rounded-2xl border border-gold/30 p-8 pt-10 transition-all duration-300 hover:shadow-ornate hover:-translate-y-1.5",
              recommended? && "shadow-ornate ring-1 ring-gold",
              !recommended? && "shadow-soft"
            ]}
          >
            <!-- Watermark numeral -->
            <span
              class="absolute -top-6 right-2 font-cinzel text-[9rem] leading-none text-navy/[0.05] group-hover:text-gold/10 transition-colors duration-500 select-none"
              aria-hidden="true"
            >
              {set.numeral}
            </span>

            <%= if recommended? do %>
              <span class="inline-block font-cinzel text-[0.65rem] tracking-[0.25em] uppercase text-navy bg-gold/90 px-3 py-1 rounded-full mb-4">
                Today's Mysteries
              </span>
            <% else %>
              <span class="inline-block font-cinzel text-[0.65rem] tracking-[0.25em] uppercase text-gold-dark border border-gold/40 px-3 py-1 rounded-full mb-4">
                {set.short_title}
              </span>
            <% end %>

            <h3 class="relative font-cinzel text-2xl text-navy mb-3">
              {set.title}
            </h3>

            <p class="relative font-garamond text-brown-light italic text-base mb-4">
              {set.schedule}
            </p>

            <p class="relative font-garamond text-brown text-lg leading-relaxed mb-6">
              {set.description}
            </p>

            <span class="relative font-cinzel text-[0.7rem] tracking-[0.15em] uppercase text-gold-dark group-hover:text-gold transition-colors">
              Enter the mysteries
              <span
                class="inline-block transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              >
                &rarr;
              </span>
            </span>
          </.link>
        <% end %>
      </div>
    </div>
  </section>

<!-- Introduction Section - The Mysteries Through Many Lights -->
  <section class="bg-white py-20 px-8" aria-labelledby="home-intro-heading">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-5 gap-12 md:gap-16">
        <!-- Heading side -->
        <div class="md:col-span-2">
          <p class="font-cinzel text-xs tracking-[0.35em] uppercase text-gold-dark mb-3">
            One Rosary, Many Ways
          </p>
          <h2
            id="home-intro-heading"
            class="font-cinzel text-4xl md:text-5xl text-navy leading-tight mb-6"
          >
            The Mysteries Through Many Lights
          </h2>
          <p class="font-garamond text-xl text-brown leading-relaxed">
            Meditate on the same sacred mysteries in the company of different
            masters&mdash;Emmerich, Liguori, Chrysostom, Newman, Sheen&mdash;each
            of whom sees the mystery with his own eyes.
          </p>
        </div>

<!-- Stacked pillars side -->
        <div class="md:col-span-3 md:border-l md:border-gold/25 md:pl-14">
          <div class="flex gap-6 py-6 border-b border-gold/20">
            <span class="font-cinzel text-4xl text-gold/60 leading-none pt-1 shrink-0">01</span>
            <div>
              <h3 class="font-cinzel text-2xl text-navy mb-2">Traditional Wisdom</h3>
              <p class="font-garamond text-lg text-brown leading-relaxed">
                Meditations drawn from the saints and doctors of the Church,
                faithful to centuries of contemplative tradition.
              </p>
            </div>
          </div>
          <div class="flex gap-6 py-6 border-b border-gold/20">
            <span class="font-cinzel text-4xl text-gold/60 leading-none pt-1 shrink-0">02</span>
            <div>
              <h3 class="font-cinzel text-2xl text-navy mb-2">Two Ways of Meditating</h3>
              <p class="font-garamond text-lg text-brown leading-relaxed">
                Enter the scene with the contemplatives, or reason on its
                meaning with the classical considerations.
              </p>
            </div>
          </div>
          <div class="flex gap-6 pt-6">
            <span class="font-cinzel text-4xl text-gold/60 leading-none pt-1 shrink-0">03</span>
            <div>
              <h3 class="font-cinzel text-2xl text-navy mb-2">A Living Library</h3>
              <p class="font-garamond text-lg text-brown leading-relaxed">
                Curated meditation sets that grow over time, so the same decade
                never grows stale.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

<!-- Seven Sorrows Section -->
  <section
    class="relative bg-cream py-20 px-8 overflow-hidden"
    aria-labelledby="seven-sorrows-heading"
  >

    <div class="relative max-w-4xl mx-auto text-center">
      <p class="font-cinzel text-xs tracking-[0.35em] uppercase text-gold-dark mb-3">
        A Devotion of Compassion
      </p>
      <h2 id="seven-sorrows-heading" class="font-cinzel text-4xl md:text-5xl text-navy mb-8">
        The Seven Sorrows of Mary
      </h2>

      <img
        src="/images/pngs/our-lady-of-sorrows-horizontal.jpg"
        alt="Our Lady of Sorrows"
        class="w-full max-w-2xl mx-auto rounded-2xl border border-gold/30 shadow-soft mb-8"
      />

      <p class="font-garamond text-xl text-brown leading-relaxed max-w-2xl mx-auto mb-10">
        Walk with the Blessed Virgin Mary through her seven sorrows, sharing in
        her maternal suffering at the foot of the Cross.
      </p>

      <div class="hairline-card px-8 py-10 md:px-12 mb-10 text-left">
        <div class="grid md:grid-cols-2 gap-x-12">
          <ul class="font-garamond text-navy text-lg">
            <li class="flex items-baseline gap-4 border-b border-gold/15 py-4">
              <span class="font-cinzel text-gold-dark w-9 shrink-0">I.</span>
              <span>The Prophecy of Simeon</span>
            </li>
            <li class="flex items-baseline gap-4 border-b border-gold/15 py-4">
              <span class="font-cinzel text-gold-dark w-9 shrink-0">II.</span>
              <span>The Flight into Egypt</span>
            </li>
            <li class="flex items-baseline gap-4 border-b border-gold/15 py-4">
              <span class="font-cinzel text-gold-dark w-9 shrink-0">III.</span>
              <span>The Loss of Jesus in the Temple</span>
            </li>
            <li class="flex items-baseline gap-4 border-b border-gold/15 py-4 md:border-b-0">
              <span class="font-cinzel text-gold-dark w-9 shrink-0">IV.</span>
              <span>Mary Meets Jesus on the Way to Calvary</span>
            </li>
          </ul>
          <ul class="font-garamond text-navy text-lg">
            <li class="flex items-baseline gap-4 border-b border-gold/15 py-4">
              <span class="font-cinzel text-gold-dark w-9 shrink-0">V.</span>
              <span>Jesus Dies on the Cross</span>
            </li>
            <li class="flex items-baseline gap-4 border-b border-gold/15 py-4">
              <span class="font-cinzel text-gold-dark w-9 shrink-0">VI.</span>
              <span>Mary Receives the Dead Body of Jesus in Her Arms</span>
            </li>
            <li class="flex items-baseline gap-4 py-4">
              <span class="font-cinzel text-gold-dark w-9 shrink-0">VII.</span>
              <span>Jesus is Placed in the Tomb</span>
            </li>
          </ul>
        </div>
      </div>

      <.gold_cta navigate="/mysteries/seven_sorrows">
        Explore the Seven Sorrows
      </.gold_cta>

      <.sacred_divider class="max-w-[210px] mx-auto my-10" />

      <p class="font-garamond text-xl text-navy italic max-w-3xl mx-auto">
        "O most holy Virgin, Mother of our Lord Jesus Christ: by the overwhelming grief
        you experienced when you witnessed the martyrdom, the crucifixion, and death of
        your divine Son, look upon me with eyes of compassion, and awaken in my heart
        a tender commiseration for those sufferings, as well as a sincere detestation
        of my sins."
      </p>

      <.sacred_divider cross={false} class="max-w-[120px] mx-auto opacity-60 mt-8 mb-0" />
    </div>
  </section>

<!-- Go Deeper Section -->
  <section class="bg-white py-20 px-8" aria-labelledby="methods-heading">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <img
          src="/images/pngs/most-sacred-heart-white-bg.jpg"
          alt="Most Sacred Heart"
          class="w-24 mx-auto mb-6 transition-transform duration-500 hover:scale-110"
        />
        <h2 id="methods-heading" class="font-cinzel text-4xl md:text-5xl text-navy mb-4">
          Go Deeper into the Rosary
        </h2>
        <p class="font-garamond text-xl text-brown leading-relaxed max-w-2xl mx-auto">
          The Rosary rewards study as much as repetition. Learn how the saints
          prayed it, and return to the scriptures it springs from.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <.link
          navigate="/rosary-methods"
          class="group relative block hairline-card p-10 hover:shadow-ornate hover:-translate-y-1 transition-all duration-300 overflow-hidden"
        >
          <h3 class="font-cinzel text-2xl text-navy mb-3">How to Pray the Rosary</h3>
          <p class="font-garamond text-lg text-brown leading-relaxed mb-6">
            A step-by-step guide through every bead and prayer, with the five
            methods of St. Louis de Montfort and the fifteen promises of the Rosary.
          </p>
          <span class="font-cinzel text-[0.7rem] tracking-[0.15em] uppercase text-gold-dark group-hover:text-gold transition-colors">
            Learn to Pray
            <span
              class="inline-block transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true"
            >
              &rarr;
            </span>
          </span>
        </.link>

        <.link
          navigate="/mysteries"
          class="group relative block hairline-card p-10 hover:shadow-ornate hover:-translate-y-1 transition-all duration-300 overflow-hidden"
        >
          <h3 class="font-cinzel text-2xl text-navy mb-3">Finding the Mysteries in Scripture</h3>
          <p class="font-garamond text-lg text-brown leading-relaxed mb-6">
            Read the scriptural accounts behind every mystery and the Seven Sorrows,
            and let the words of the Gospel anchor every decade you pray.
          </p>
          <span class="font-cinzel text-[0.7rem] tracking-[0.15em] uppercase text-gold-dark group-hover:text-gold transition-colors">
            Read the Scriptures
            <span
              class="inline-block transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true"
            >
              &rarr;
            </span>
          </span>
        </.link>

        <.link
          navigate="/true-devotion"
          class="group relative block hairline-card p-10 hover:shadow-ornate hover:-translate-y-1 transition-all duration-300 overflow-hidden"
        >
          <h3 class="font-cinzel text-2xl text-navy mb-3">True Devotion to Mary</h3>
          <p class="font-garamond text-lg text-brown leading-relaxed mb-6">
            The secret of the saints according to St. Louis de Montfort: to Jesus
            through Mary, and the total consecration that crowns the Rosary.
          </p>
          <span class="font-cinzel text-[0.7rem] tracking-[0.15em] uppercase text-gold-dark group-hover:text-gold transition-colors">
            Discover the Devotion
            <span
              class="inline-block transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true"
            >
              &rarr;
            </span>
          </span>
        </.link>
      </div>

<!-- St. Carlo banner -->
      <.link
        navigate="/saint-carlo"
        class="group relative block hairline-card ornate-corners mt-8 p-8 md:p-10 hover:shadow-ornate transition-all duration-300 overflow-hidden"
      >
        <div class="absolute inset-0 opacity-[0.04]" aria-hidden="true">
          <img
            src="/images/ornate-blue-gold-bg-symbols.jpg"
            alt=""
            class="w-full h-full object-cover"
          />
        </div>
        <div class="relative flex flex-col md:flex-row md:items-center gap-4 md:gap-8">
          <div class="flex-1">
            <p class="font-cinzel text-[0.65rem] tracking-[0.3em] uppercase text-gold-dark mb-2">
              Patron of Lumen Viae
            </p>
            <h3 class="font-cinzel text-2xl md:text-3xl text-navy mb-2">
              St. Carlo Acutis, the First Millennial Saint
            </h3>
            <p class="font-garamond text-lg text-brown leading-relaxed max-w-2xl">
              Daily Mass, the daily Rosary, and a website that carried the
              Eucharistic miracles of the world to five continents. Meet the
              saint who watches over this apostolate.
            </p>
          </div>
          <span class="font-cinzel text-[0.7rem] tracking-[0.15em] uppercase text-gold-dark shrink-0 group-hover:text-gold group-hover:translate-x-1 transition-all duration-300">
            Meet St. Carlo &rarr;
          </span>
        </div>
      </.link>
    </div>
  </section>

<!-- App Promotion -->
  <section
    class="relative bg-navy-dark overflow-hidden border-t-3 border-gold py-20 px-8"
    aria-labelledby="app-promo-heading"
  >
    <div class="absolute inset-0 opacity-[0.04]" aria-hidden="true">
      <img
        src="/images/ornate-blue-gold-bg-symbols.jpg"
        alt=""
        class="w-full h-full object-cover"
      />
    </div>

    <div class="relative max-w-5xl mx-auto grid md:grid-cols-2 gap-14 items-center">
      <div>
        <p class="font-cinzel text-xs tracking-[0.35em] uppercase text-gold-light/70 mb-3">
          Lumen Viae for iPhone
        </p>
        <h2 id="app-promo-heading" class="font-cinzel text-4xl md:text-5xl text-cream mb-6">
          Carry the Rosary in Your Pocket
        </h2>
        <p class="font-garamond text-xl text-gold-light leading-relaxed mb-8">
          Guided audio meditations, the daily mysteries, and the full meditation
          library&mdash;wherever your day takes you.
        </p>
        <.gold_cta navigate="/app">
          Discover the App <span aria-hidden="true">&rarr;</span>
        </.gold_cta>
      </div>

      <div class="flex justify-center">
        <div class="phone-frame" style="width: 14rem">
          <div class="phone-notch"></div>
          <div class="phone-screen bg-gradient-to-b from-navy to-navy-dark items-center justify-center text-center px-6">
            <img
              src="/images/pngs/blessed-mary-with-child-jesus-rustic-cutout.png"
              alt="Sample app screen showing Blessed Virgin Mary"
              class="w-24 mx-auto mb-4 opacity-90"
            />
            <p class="font-cinzel text-[0.55rem] tracking-[0.3em] uppercase text-gold-light/70 mb-2">
              {Calendar.strftime(@today, "%A")}
            </p>
            <p class="font-cinzel text-lg text-cream leading-snug mb-4">
              {@recommended_set.title}
            </p>
            <div class="flex justify-center gap-1.5 mb-4" aria-hidden="true">
              <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-gold/60"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-gold/40"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-gold/40"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-gold/40"></span>
            </div>
            <span class="inline-block font-cinzel text-[0.6rem] tracking-widest uppercase text-navy bg-gold px-4 py-1.5 rounded-full">
              Begin
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

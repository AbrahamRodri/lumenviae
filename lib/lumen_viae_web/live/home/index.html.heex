<div class="min-h-screen bg-night" id="home-page" phx-hook="UserTimezone">
  <!-- Hero: the page's one deep band -->
  <section
    class="home-hero relative bg-night-deep overflow-hidden border-b border-night-border"
    aria-labelledby="home-hero-heading"
  >
    <div class="absolute inset-0 opacity-[0.05]" aria-hidden="true">
      <picture class="contents">
        <source
          type="image/webp"
          srcset="/images/ornate-blue-gold-bg-symbols-480.webp 480w, /images/ornate-blue-gold-bg-symbols-735.webp 735w"
          sizes="100vw"
        />
        <img
          src="/images/ornate-blue-gold-bg-symbols.jpg"
          width="735"
          height="489"
          alt=""
          class="w-full h-full object-cover"
        />
      </picture>
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-night-deep/60 via-transparent to-night/90"
      aria-hidden="true"
    >
    </div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-8 pt-10 pb-12 md:pt-14 md:pb-16 text-center">
      <div class="relative inline-block mb-6 animate-rise">
        <div class="bg-halo absolute -inset-8 rounded-full animate-halo" aria-hidden="true"></div>
        <picture>
          <source
            type="image/webp"
            srcset="/images/pngs/blessed-mary-with-child-jesus-rustic-cutout-320.webp 320w, /images/pngs/blessed-mary-with-child-jesus-rustic-cutout-512.webp 512w"
            sizes="(min-width: 768px) 176px, 128px"
          />
          <img
            src="/images/pngs/blessed-mary-with-child-jesus-rustic-cutout.png"
            width="864"
            height="1512"
            alt="The Blessed Virgin Mary holding the Child Jesus"
            class="relative w-32 md:w-44 mx-auto drop-shadow-2xl"
          />
        </picture>
      </div>

      <h1
        id="home-hero-heading"
        class="font-display font-semibold text-[2.5rem] leading-[1.1] sm:text-6xl md:text-7xl text-ink-light mb-8 animate-rise"
        style="animation-delay: 200ms"
      >
        The Rosary, Illuminated
      </h1>

      <!-- The week as a strand of beads, today's lit -->
      <div class="animate-rise mb-8" style="animation-delay: 400ms">
        <div class="relative max-w-sm mx-auto">
          <div class="absolute top-[0.4rem] inset-x-6 h-px bg-night-line" aria-hidden="true">
          </div>
          <ol class="relative flex items-start justify-between" aria-label="This week's mysteries">
            <li :for={day <- @week} class="flex flex-col items-center gap-2 flex-1 min-w-0">
              <span class={["bead", day.today? && "bead-today"]} aria-hidden="true"></span>
              <span
                class={[
                  "font-garamond text-sm",
                  day.today? && "text-gilt font-semibold",
                  !day.today? && "text-ink-muted"
                ]}
                aria-hidden="true"
              >
                {day.label}
              </span>
              <span class="sr-only">
                {day.day_name}: the {day.mysteries}{if day.today?, do: " (today)"}
              </span>
            </li>
          </ol>
        </div>
      </div>

      <div class="animate-rise" style="animation-delay: 500ms">
        <.gold_cta
          navigate={@today_category.path}
          id="pray-today"
        >
          Pray the {@today_category.devotion_title}
        </.gold_cta>
      </div>
    </div>
  </section>

  <!-- Today's devotion: the mysteries, the sets for them, and the set-less forms -->
  <section class="px-4 sm:px-8 py-12 md:py-16" aria-labelledby="todays-devotion-heading">
    <div class="max-w-6xl mx-auto grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="min-w-0">
        <p class="section-label">
          {Calendar.strftime(@today, "%A")}'s Devotion
        </p>
        <h2
          id="todays-devotion-heading"
          class="font-display text-4xl md:text-5xl text-ink-light leading-tight"
        >
          {@today_category.title}
        </h2>
        <p class="font-garamond text-xl text-ink-muted italic mt-1 mb-5">
          {@today_category.subtitle}
        </p>

        <div
          id="mystery-schedule"
          phx-hook="MysterySchedule"
          data-schedule={@schedule}
          role="group"
          aria-label="Which schedule the week follows"
          class="mb-6 inline-flex items-center justify-center gap-1 rounded-full border border-night-line p-0.5"
        >
          <button
            :for={schedule <- LumenViae.LiturgicalCalendar.schedules()}
            type="button"
            phx-click="set_schedule"
            phx-value-schedule={schedule}
            aria-pressed={to_string(@schedule == schedule)}
            title={schedule_detail(schedule)}
            class={[
              "rounded-full px-4 min-h-11 font-garamond text-base motion-safe:transition-colors",
              if(@schedule == schedule,
                do: "bg-gilt text-night font-semibold",
                else: "text-ink-muted hover:text-ink-light"
              )
            ]}
          >
            {schedule_name(schedule)}
          </button>
        </div>

        <ol
          id="todays-mysteries"
          class="border-t border-night-border"
          aria-label={"The #{length(@today_category.mysteries)} mysteries"}
        >
          <li
            :for={mystery <- @today_category.mysteries}
            class="flex items-baseline gap-3 py-2.5 border-b border-night-border"
          >
            <span class="font-display text-gilt text-lg w-8 shrink-0" aria-hidden="true">
              {mystery.numeral}
            </span>
            <p class="min-w-0 font-garamond text-lg text-ink-light leading-snug">
              {mystery.name}<span :if={mystery.fruit} class="italic text-base text-ink-muted"><span aria-hidden="true"> &middot; </span><span class="sr-only">. Fruit: </span>{mystery.fruit}</span>
            </p>
          </li>
        </ol>
      </div>

      <div class="flex min-w-0 flex-col gap-10">
        <!-- Pray with a meditation set -->
        <div id="todays-sets">
          <h3 class="section-label">Pray with the Saints</h3>
          <%= if @todays_sets == [] do %>
            <p class="font-garamond text-lg text-ink-muted italic">
              No meditation sets are available yet for these mysteries. Pray them
              with the Scriptures, or with the prayers alone, below.
            </p>
          <% else %>
            <ul class="row-list">
              <li :for={set <- @todays_sets}>
                <.link navigate={"/meditation-sets/#{set.id}/pray"} class="row-link home-row">
                  <SetPortrait.set_portrait set={set} sizes="44px" class="w-11 h-14" />
                  <span class="flex-1 min-w-0">
                    <span class="block font-garamond text-lg font-semibold text-ink-light leading-snug">
                      {set.name}
                    </span>
                    <span
                      :if={set_detail(set)}
                      class="block font-garamond text-base text-ink-muted leading-snug"
                    >
                      {set_detail(set)}
                    </span>
                  </span>
                  <span class="hero-chevron-right size-5 row-chevron" aria-hidden="true" />
                </.link>
              </li>
            </ul>
            <p class="mt-2 text-center">
              <button
                type="button"
                phx-click="providence"
                id="divine-providence"
                class="btn-text"
              >
                Let one be chosen for me
              </button>
            </p>
          <% end %>
        </div>

        <!-- The Rosary without a set -->
        <div id="todays-forms">
          <h3 class="section-label">Without a Set</h3>
          <ul class="row-list">
            <li>
              <.link navigate={scriptural_path(@today_category.slug)} class="row-link home-row">
                <span class="glyph-badge" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.4"
                  >
                    <path d="M4 5.5C4 4.7 4.7 4 5.5 4H11v16H5.5C4.7 20 4 19.3 4 18.5v-13zM20 5.5C20 4.7 19.3 4 18.5 4H13v16h5.5c.8 0 1.5-.7 1.5-1.5v-13z" />
                    <path d="M7 8h2M15 8h2" />
                  </svg>
                </span>
                <span class="flex-1 min-w-0">
                  <span class="block font-garamond text-lg font-semibold text-ink-light leading-snug">
                    The Scriptural Rosary
                  </span>
                  <span class="block font-garamond text-base text-ink-muted leading-snug">
                    A verse of Holy Scripture before each Hail Mary
                  </span>
                </span>
                <span class="hero-chevron-right size-5 row-chevron" aria-hidden="true" />
              </.link>
            </li>
            <li>
              <.link navigate={aloud_path(@today_category.slug)} class="row-link home-row">
                <span class="glyph-badge" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.4"
                  >
                    <path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5H4z" />
                    <path d="M15.5 9a4 4 0 010 6M17.8 6.5a7.5 7.5 0 010 11" />
                  </svg>
                </span>
                <span class="flex-1 min-w-0">
                  <span class="block font-garamond text-lg font-semibold text-ink-light leading-snug">
                    The Rosary Said Aloud
                  </span>
                  <span class="block font-garamond text-base text-ink-muted leading-snug">
                    Every prayer spoken aloud, with no meditation between
                  </span>
                </span>
                <span class="hero-chevron-right size-5 row-chevron" aria-hidden="true" />
              </.link>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Every category, as the app's "all mysteries" -->
  <section
    class="border-t border-night-border px-4 sm:px-8 py-12 md:py-16"
    aria-labelledby="all-mysteries-heading"
  >
    <div class="max-w-6xl mx-auto">
      <h2 id="all-mysteries-heading" class="section-label">
        The Mysteries of the Rosary
      </h2>

      <%!-- Two to a row on a phone, with the fifth card the width of both, so
            no card is left alone on the last row. --%>
      <ul class="grid grid-cols-2 gap-3 sm:gap-5 md:grid-cols-3 lg:grid-cols-5">
        <li
          :for={{category, index} <- Enum.with_index(@categories)}
          class={[
            "home-card-item min-w-0",
            wide_card?(index, @categories) && "col-span-2 md:col-span-1"
          ]}
          id={"category-#{category.slug}"}
        >
          <LumenViaeWeb.Live.Home.CategoryCard.category_card
            category={category}
            today?={category.slug == @today_category.slug}
            wide?={wide_card?(index, @categories)}
          />
        </li>
      </ul>
    </div>
  </section>
</div>

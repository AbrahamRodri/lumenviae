<div class="min-h-screen" id="home-page" phx-hook="UserTimezone">
  <!-- Hero: the app's lancet arch, today's painting dissolving into the page -->
  <section class="home-hero relative" aria-labelledby="home-hero-heading">
    <%!-- The arch's shape, in the plate's own units, for clip-path. --%>
    <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
      <clipPath id="lancet-hero-arch" clipPathUnits="objectBoundingBox">
        <path d="M0,1 L0,0.34 C0,0.17 0.22,0.045 0.5,0 C0.78,0.045 1,0.17 1,0.34 L1,1 Z" />
      </clipPath>
    </svg>

    <div class="relative max-w-xl mx-auto px-5 pt-8 pb-10 md:pt-12 md:pb-14 text-center">
      <h1
        id="home-hero-heading"
        class="font-display text-[1.75rem] sm:text-4xl md:text-5xl text-ink-light leading-tight animate-rise"
      >
        The Rosary, Illuminated
      </h1>

      <!-- The week as a strand of beads, today's lit -->
      <div class="animate-rise mt-5" style="animation-delay: 120ms">
        <div class="relative max-w-sm mx-auto">
          <div class="absolute top-[0.4rem] inset-x-6 h-px bg-night-line" aria-hidden="true">
          </div>
          <ol class="relative flex items-start justify-between" aria-label="This week's mysteries">
            <li :for={day <- @week} class="flex flex-col items-center gap-2 flex-1 min-w-0">
              <span class={["bead", day.today? && "bead-today"]} aria-hidden="true"></span>
              <span
                class={[
                  "font-garamond text-sm",
                  day.today? && "text-gilt font-semibold",
                  !day.today? && "text-ink-muted"
                ]}
                aria-hidden="true"
              >
                {day.label}
              </span>
              <span class="sr-only">
                {day.day_name}: the {day.mysteries}{if day.today?, do: " (today)"}
              </span>
            </li>
          </ol>
        </div>
      </div>

      <div class="lancet-hero mt-7 animate-rise" style="animation-delay: 240ms">
        <div class="lancet-hero__art" aria-hidden="true">
          <div class="lancet-hero__fade">
            <div class="lancet-hero__plate">
              <MysteryPainting.picture
                category={@today_category.slug}
                record={@today_category.painting && @today_category.painting.record}
                sizes="(min-width: 640px) 34rem, 92vw"
                loading="eager"
                alt=""
                class="lancet-hero__image"
                style={"object-position: #{hero_position(@today_category)}"}
              />
            </div>
            <svg class="lancet-hero__rim" viewBox="0 0 100 100" preserveAspectRatio="none">
              <path d="M0.4,100 L0.4,34 C0.4,17 22,4.5 50,0.4 C78,4.5 99.6,17 99.6,34 L99.6,100" />
              <path
                class="lancet-hero__rim-inner"
                d="M2.4,100 L2.4,34.5 C2.4,18.5 23,6.5 50,2.8 C77,6.5 97.6,18.5 97.6,34.5 L97.6,100"
              />
            </svg>
          </div>
        </div>

        <div class="lancet-hero__words">
          <span class="badge-capsule">Today's Mysteries</span>
          <p class="font-display font-semibold text-[1.625rem] sm:text-4xl text-ink-light leading-tight mt-3 mb-5 [text-shadow:0_1px_6px_rgba(0,0,0,0.6)]">
            {@today_category.title}
          </p>
          <.gold_cta navigate={@today_category.path} id="pray-today">
            Pray the {@today_category.devotion_title} <span aria-hidden="true">&rsaquo;</span>
          </.gold_cta>
        </div>
      </div>
    </div>
  </section>

  <!-- Today's devotion: the mysteries, the sets for them, and the set-less forms -->
  <section class="px-4 sm:px-8 py-12 md:py-16" aria-labelledby="todays-devotion-heading">
    <div class="max-w-6xl mx-auto grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="min-w-0">
        <p class="section-label">
          {Calendar.strftime(@today, "%A")}'s Devotion
        </p>
        <h2
          id="todays-devotion-heading"
          class="font-display text-[1.75rem] md:text-4xl text-ink-light leading-tight"
        >
          {@today_category.title}
        </h2>
        <p class="font-garamond text-lg text-ink-muted italic mt-1 mb-5">
          {@today_category.subtitle}
        </p>

        <div
          id="mystery-schedule"
          phx-hook="MysterySchedule"
          data-schedule={@schedule}
          role="group"
          aria-label="Which schedule the week follows"
          class="mb-6 inline-flex items-center justify-center gap-1 rounded-full border border-night-line p-0.5"
        >
          <button
            :for={schedule <- LumenViae.LiturgicalCalendar.schedules()}
            type="button"
            phx-click="set_schedule"
            phx-value-schedule={schedule}
            aria-pressed={to_string(@schedule == schedule)}
            title={schedule_detail(schedule)}
            class={[
              "rounded-full px-4 min-h-11 font-garamond text-base motion-safe:transition-colors",
              if(@schedule == schedule,
                do: "bg-gilt text-night font-semibold",
                else: "text-ink-muted hover:text-ink-light"
              )
            ]}
          >
            {schedule_name(schedule)}
          </button>
        </div>

        <ol
          id="todays-mysteries"
          class="mystery-ledger"
          aria-label={"The #{length(@today_category.mysteries)} mysteries"}
        >
          <li :for={mystery <- @today_category.mysteries}>
            <span class="mystery-ledger__numeral" aria-hidden="true">{mystery.numeral}</span>
            <span class="mystery-thumb" aria-hidden="true">
              <MysteryPainting.picture
                key={mystery.key}
                record={mystery.record}
                sizes="44px"
                alt=""
                class="w-full h-full object-cover"
              />
            </span>
            <p class="min-w-0">
              <span class="block text-lg text-ink-light leading-snug">{mystery.name}</span>
              <span :if={mystery.fruit} class="block italic text-base text-ink-muted">
                <span class="sr-only">Fruit: </span>{mystery.fruit}
              </span>
            </p>
          </li>
        </ol>
      </div>

      <div class="flex min-w-0 flex-col gap-10">
        <!-- Pray with a meditation set -->
        <div id="todays-sets">
          <h3 class="section-heading">Pray with the Saints</h3>
          <p class="italic text-base text-ink-muted mt-0.5 mb-2">
            Each opens straight into the Rosary
          </p>
          <%= if @todays_sets == [] do %>
            <p class="font-garamond text-lg text-ink-muted italic">
              No meditation sets are available yet for these mysteries. Pray them
              with the Scriptures, or with the prayers alone, below.
            </p>
          <% else %>
            <ul class="row-list">
              <li :for={set <- @todays_sets}>
                <.link navigate={"/meditation-sets/#{set.id}/pray"} class="row-link home-row">
                  <SetPortrait.set_portrait set={set} sizes="64px" class="w-16 h-16" />
                  <span class="flex-1 min-w-0">
                    <span class="row-title">{set.name}</span>
                    <span :if={set_detail(set)} class="row-fact">{set_detail(set)}</span>
                  </span>
                  <span class="hero-chevron-right size-5 row-chevron" aria-hidden="true" />
                </.link>
              </li>
            </ul>
            <p class="mt-2 text-center">
              <button
                type="button"
                phx-click="providence"
                id="divine-providence"
                class="btn-text"
              >
                Let one be chosen for me <span aria-hidden="true">&rsaquo;</span>
              </button>
            </p>
          <% end %>
        </div>

        <!-- The Rosary without a set -->
        <div id="todays-forms">
          <h3 class="section-label">Without a Set</h3>
          <ul class="row-list">
            <li>
              <.link navigate={scriptural_path(@today_category.slug)} class="row-link home-row">
                <span class="glyph-badge" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.4"
                  >
                    <path d="M4 5.5C4 4.7 4.7 4 5.5 4H11v16H5.5C4.7 20 4 19.3 4 18.5v-13zM20 5.5C20 4.7 19.3 4 18.5 4H13v16h5.5c.8 0 1.5-.7 1.5-1.5v-13z" />
                    <path d="M7 8h2M15 8h2" />
                  </svg>
                </span>
                <span class="flex-1 min-w-0">
                  <span class="row-title !font-normal">The Scriptural Rosary</span>
                  <span class="block italic text-base text-ink-muted leading-snug">
                    A verse of Holy Scripture before each Hail Mary
                  </span>
                </span>
                <span class="hero-chevron-right size-5 row-chevron" aria-hidden="true" />
              </.link>
            </li>
            <li>
              <.link navigate={aloud_path(@today_category.slug)} class="row-link home-row">
                <span class="glyph-badge" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.4"
                  >
                    <path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5H4z" />
                    <path d="M15.5 9a4 4 0 010 6M17.8 6.5a7.5 7.5 0 010 11" />
                  </svg>
                </span>
                <span class="flex-1 min-w-0">
                  <span class="row-title !font-normal">The Audio Rosary</span>
                  <span class="block italic text-base text-ink-muted leading-snug">
                    You hear every prayer, with no meditation between
                  </span>
                </span>
                <span class="hero-chevron-right size-5 row-chevron" aria-hidden="true" />
              </.link>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <.sacred_divider class="!my-0" />

  <!-- Every category, as the app's "all mysteries" -->
  <section class="px-4 sm:px-8 py-12 md:py-16" aria-labelledby="all-mysteries-heading">
    <div class="max-w-6xl mx-auto">
      <h2 id="all-mysteries-heading" class="section-heading">
        The Mysteries of the Rosary
      </h2>
      <p class="italic text-base text-ink-muted mt-0.5 mb-4">
        Scenes from the lives of Jesus and Mary
      </p>

      <%!-- Two to a row on a phone, with the fifth card the width of both, so
            no card is left alone on the last row. --%>
      <ul class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-5">
        <li
          :for={{category, index} <- Enum.with_index(@categories)}
          class={[
            "home-card-item min-w-0",
            wide_card?(index, @categories) && "col-span-2 md:col-span-1"
          ]}
          id={"category-#{category.slug}"}
        >
          <LumenViaeWeb.Live.Home.CategoryCard.category_card
            category={category}
            today?={category.slug == @today_category.slug}
            wide?={wide_card?(index, @categories)}
          />
        </li>
      </ul>
    </div>
  </section>
</div>

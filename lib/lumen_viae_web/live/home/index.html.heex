<div class="min-h-screen bg-night" id="home-page" phx-hook="UserTimezone">
  <!-- Hero: the page's one deep band -->
  <section
    class="home-hero relative bg-night-deep overflow-hidden border-b border-night-border"
    aria-labelledby="home-hero-heading"
  >
    <div class="absolute inset-0 opacity-[0.05]" aria-hidden="true">
      <picture class="contents">
        <source
          type="image/webp"
          srcset="/images/ornate-blue-gold-bg-symbols-480.webp 480w, /images/ornate-blue-gold-bg-symbols-735.webp 735w"
          sizes="100vw"
        />
        <img
          src="/images/ornate-blue-gold-bg-symbols.jpg"
          width="735"
          height="489"
          alt=""
          class="w-full h-full object-cover"
        />
      </picture>
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-night-deep/60 via-transparent to-night/90"
      aria-hidden="true"
    >
    </div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-8 pt-10 pb-12 md:pt-14 md:pb-16 text-center">
      <div class="relative inline-block mb-6 animate-rise">
        <div class="bg-halo absolute -inset-8 rounded-full animate-halo" aria-hidden="true"></div>
        <picture>
          <source
            type="image/webp"
            srcset="/images/pngs/blessed-mary-with-child-jesus-rustic-cutout-320.webp 320w, /images/pngs/blessed-mary-with-child-jesus-rustic-cutout-512.webp 512w"
            sizes="(min-width: 768px) 176px, 128px"
          />
          <img
            src="/images/pngs/blessed-mary-with-child-jesus-rustic-cutout.png"
            width="864"
            height="1512"
            alt="The Blessed Virgin Mary holding the Child Jesus"
            class="relative w-32 md:w-44 mx-auto drop-shadow-2xl"
          />
        </picture>
      </div>

      <p class="kicker mb-3 animate-rise" style="animation-delay: 120ms">
        Lumen Viae &middot; The Light of the Way
      </p>

      <h1
        id="home-hero-heading"
        class="font-display font-semibold text-[2.5rem] leading-[1.1] sm:text-6xl md:text-7xl text-ink-light mb-4 animate-rise"
        style="animation-delay: 200ms"
      >
        The Rosary, Illuminated
      </h1>

      <p
        class="font-garamond text-lg md:text-xl text-ink-muted italic max-w-xl mx-auto leading-relaxed mb-8 animate-rise"
        style="animation-delay: 300ms"
      >
        Pray the Holy Rosary each day with the meditations of the saints and
        doctors of the Church.
      </p>

      <!-- The week as a strand of beads, today's lit -->
      <div class="animate-rise mb-8" style="animation-delay: 400ms">
        <div class="relative max-w-sm mx-auto">
          <div class="absolute top-[0.4rem] inset-x-6 h-px bg-night-line" aria-hidden="true">
          </div>
          <ol class="relative flex items-start justify-between" aria-label="This week's mysteries">
            <li :for={day <- @week} class="flex flex-col items-center gap-2 flex-1 min-w-0">
              <span class={["bead", day.today? && "bead-today"]} aria-hidden="true"></span>
              <span
                class={[
                  "font-garamond text-sm",
                  day.today? && "text-gilt font-semibold",
                  !day.today? && "text-ink-muted"
                ]}
                aria-hidden="true"
              >
                {day.label}
              </span>
              <span class="sr-only">
                {day.day_name}: the {day.mysteries}{if day.today?, do: " (today)"}
              </span>
            </li>
          </ol>
        </div>

        <div
          id="mystery-schedule"
          phx-hook="MysterySchedule"
          data-schedule={@schedule}
          role="group"
          aria-label="Which schedule the week follows"
          class="mt-4 inline-flex items-center justify-center gap-1 rounded-full border border-night-line p-0.5"
        >
          <button
            :for={schedule <- LumenViae.LiturgicalCalendar.schedules()}
            type="button"
            phx-click="set_schedule"
            phx-value-schedule={schedule}
            aria-pressed={to_string(@schedule == schedule)}
            title={schedule_detail(schedule)}
            class={[
              "rounded-full px-4 min-h-11 font-garamond text-base motion-safe:transition-colors",
              if(@schedule == schedule,
                do: "bg-gilt text-night font-semibold",
                else: "text-ink-muted hover:text-ink-light"
              )
            ]}
          >
            {schedule_name(schedule)}
          </button>
        </div>
      </div>

      <div class="animate-rise" style="animation-delay: 500ms">
        <p class="font-garamond text-lg text-ink-muted mb-5">
          Today is {Calendar.strftime(@today, "%A")} &mdash;
          <span class="text-ink-light">{@today_category.title}</span>
        </p>
        <.gold_cta
          navigate={@today_category.path}
          id="pray-today"
          aria-label={"Pray the Rosary: #{@today_category.title}"}
        >
          Pray the Rosary
        </.gold_cta>
      </div>
    </div>
  </section>

  <!-- Today's devotion: the mysteries, the sets for them, and the set-less forms -->
  <section class="px-4 sm:px-8 py-14 md:py-20" aria-labelledby="todays-devotion-heading">
    <div class="max-w-6xl mx-auto grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="min-w-0">
        <p class="kicker mb-2">
          {Calendar.strftime(@today, "%A")}'s Devotion
        </p>
        <h2
          id="todays-devotion-heading"
          class="font-display text-4xl md:text-5xl text-ink-light leading-tight mb-2"
        >
          {@today_category.title}
        </h2>
        <p class="font-garamond text-xl text-ink-muted italic mb-6">
          {@today_category.subtitle}
        </p>

        <ol
          id="todays-mysteries"
          class="border-l border-night-border"
          aria-label={"The #{length(@today_category.mysteries)} mysteries"}
        >
          <li
            :for={mystery <- @today_category.mysteries}
            class="flex items-baseline gap-4 pl-5 py-3 border-b border-night-border last:border-b-0"
          >
            <span class="font-display text-gilt text-xl w-9 shrink-0" aria-hidden="true">
              {mystery.numeral}.
            </span>
            <div class="min-w-0">
              <p class="font-garamond text-xl text-ink-light leading-snug">{mystery.name}</p>
              <p :if={mystery.fruit} class="font-garamond text-base text-ink-muted">
                <span class="kicker text-xs">Fruit</span>
                {mystery.fruit}
              </p>
            </div>
          </li>
        </ol>
      </div>

      <div class="flex min-w-0 flex-col gap-10">
        <!-- Pray with a meditation set -->
        <div id="todays-sets">
          <h3 class="font-display text-2xl md:text-3xl text-ink-light mb-2">
            Pray with the Saints
          </h3>
          <%= if @todays_sets == [] do %>
            <p class="font-garamond text-lg text-ink-muted italic">
              No meditation sets are available yet for these mysteries. Pray them
              with the Scriptures, or with the prayers alone, below.
            </p>
          <% else %>
            <p class="font-garamond text-lg text-ink-muted mb-5">
              Choose whose meditations to pray with today. Each opens straight
              into the Rosary.
            </p>
            <ul class="space-y-2.5 mb-6">
              <li :for={set <- @todays_sets}>
                <.link
                  navigate={"/meditation-sets/#{set.id}/pray"}
                  class="home-row group hairline-card flex flex-wrap items-center gap-x-3 gap-y-1 px-5 py-3 min-h-12 hover:border-night-line transition-colors"
                >
                  <span class="flex-1 min-w-0 basis-40 font-garamond text-lg text-ink-light group-hover:text-gilt transition-colors">
                    {set.name}
                  </span>
                  <span
                    :if={has_audio?(set)}
                    class="flex items-center gap-1.5 shrink-0 font-garamond text-sm text-sky"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="w-4 h-4"
                      aria-hidden="true"
                    >
                      <path d="M12 2C6.477 2 2 6.477 2 12v4a2 2 0 002 2h2a2 2 0 002-2v-3a2 2 0 00-2-2H4.062A8.001 8.001 0 0112 4a8.001 8.001 0 017.938 7H18a2 2 0 00-2 2v3a2 2 0 002 2h2a2 2 0 002-2v-4c0-5.523-4.477-10-10-10z" />
                    </svg>
                    Guided audio
                  </span>
                  <span
                    class="text-gilt shrink-0 group-hover:translate-x-0.5 transition-transform"
                    aria-hidden="true"
                  >
                    &rarr;
                  </span>
                </.link>
              </li>
            </ul>
            <button
              type="button"
              phx-click="providence"
              id="divine-providence"
              class="btn-outline-gold w-full sm:w-auto"
              aria-describedby="divine-providence-help"
            >
              Divine Providence
            </button>
            <p
              id="divine-providence-help"
              class="font-garamond italic text-base text-ink-muted mt-2"
            >
              Let one of today's sets be chosen for you.
            </p>
          <% end %>
        </div>

        <!-- The Rosary without a set -->
        <div id="todays-forms">
          <h3 class="font-display text-2xl md:text-3xl text-ink-light mb-4">
            Other Ways to Pray Today
          </h3>
          <ul class="grid gap-2.5 sm:grid-cols-2">
            <li class="min-w-0">
              <.link
                navigate={scriptural_path(@today_category.slug)}
                class="home-row group hairline-card flex flex-col h-full px-5 py-4 hover:border-night-line transition-colors"
              >
                <span class="font-display text-xl font-semibold text-ink-light group-hover:text-gilt transition-colors">
                  The Scriptural Rosary
                </span>
                <span class="font-garamond text-base text-ink-muted">
                  A verse of Holy Scripture before each Hail Mary.
                </span>
              </.link>
            </li>
            <li class="min-w-0">
              <.link
                navigate={aloud_path(@today_category.slug)}
                class="home-row group hairline-card flex flex-col h-full px-5 py-4 hover:border-night-line transition-colors"
              >
                <span class="font-display text-xl font-semibold text-ink-light group-hover:text-gilt transition-colors">
                  The Rosary Said Aloud
                </span>
                <span class="font-garamond text-base text-ink-muted">
                  Every prayer spoken aloud, with no meditation between.
                </span>
              </.link>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Every category, as the app's "all mysteries" -->
  <section
    class="border-t border-night-border px-4 sm:px-8 py-14 md:py-20"
    aria-labelledby="all-mysteries-heading"
  >
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <h2
          id="all-mysteries-heading"
          class="font-display text-4xl md:text-5xl text-ink-light mb-3"
        >
          The Mysteries of the Rosary
        </h2>
        <p class="font-garamond text-lg md:text-xl text-ink-muted max-w-xl mx-auto">
          Scenes from the lives of Jesus and Mary. Choose which to pray.
        </p>
      </div>

      <ul class="grid grid-cols-2 gap-3 sm:gap-5 md:grid-cols-3 lg:grid-cols-5">
        <li
          :for={category <- @categories}
          class="home-card-item min-w-0"
          id={"category-#{category.slug}"}
        >
          <LumenViaeWeb.Live.Home.CategoryCard.category_card
            category={category}
            today?={category.slug == @today_category.slug}
          />
        </li>
      </ul>

      <.sacred_divider class="max-w-[210px] mx-auto mt-14 mb-0" />
    </div>
  </section>
</div>

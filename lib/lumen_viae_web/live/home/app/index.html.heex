<div id="app-page" class="app-c" lang={@lang} data-html-lang={@lang} phx-hook="AppRise">
  <section class="app-c__hero" aria-labelledby="app-title">
    <LumenViaeWeb.Components.MysteryPainting.picture
      name="joyful_annunciation"
      sizes="100vw"
      class="app-c__hero-painting"
      loading="eager"
      fetchpriority="high"
      alt=""
    />
    <div class="app-c__wrap app-c__hero-inner">
      <div class="app-c__hero-words">
        <p class="app-c__kicker">{@t.kicker}</p>
        <h1 id="app-title" class="app-c__h1">{@t.h1}</h1>
        <p class="app-c__lede">{@t.lede}</p>
        <.app_store_button href={@app_store_url} free={@t.free} badge={@t.badge} />
      </div>
      <.clip
        name={Map.get(@t.clip_names, "c1-player", "c1-player")}
        alt={@t.clips["c1-player"]}
        pause={@t.pause}
        play={@t.play}
        class="app-phone--hero"
      />
    </div>
  </section>

  <ul class="app-c__proof" data-role="proof">
    <li :for={fact <- @t.proof}>{fact}</li>
  </ul>

  <section class="app-c__rows">
    <div class="app-c__wrap">
      <article class="app-c__row app-c__row--phone" data-rise>
        <LumenViaeWeb.Components.MysteryPainting.picture
          name="sorrowful_carrying"
          sizes="(min-width: 768px) 560px, 100vw"
          class="app-c__row-painting"
          alt=""
        />
        <.clip
          name="c3-beads"
          alt={@t.clips["c3-beads"]}
          pause={@t.pause}
          play={@t.play}
          class="app-phone--tile app-phone--row"
        />
        <div class="app-c__row-words">
          <p class="app-c__kicker">{@t.rosary_kicker}</p>
          <h2 class="app-c__h2">{@t.rosary_title}</h2>
          <p>{@t.rosary_body}</p>
        </div>
      </article>
      <article class="app-c__row app-c__row--flip app-c__row--phone" data-rise>
        <div class="app-c__row-words">
          <p class="app-c__kicker">{@t.chant_kicker}</p>
          <h2 class="app-c__h2">{@t.chant_title}</h2>
          <p>{@t.chant_body}</p>
        </div>
        <.clip
          name="c5-chant"
          alt={@t.clips["c5-chant"]}
          pause={@t.pause}
          play={@t.play}
          class="app-phone--tile app-phone--row"
        />
        <LumenViaeWeb.Components.MysteryPainting.picture
          name="mary_sistine_madonna"
          sizes="(min-width: 768px) 560px, 100vw"
          class="app-c__row-painting"
          alt=""
        />
      </article>
    </div>
  </section>

  <section class="app-c__tiles" aria-labelledby="app-tiles-title">
    <div class="app-c__wrap">
      <p class="app-c__kicker">{@t.tiles_kicker}</p>
      <h2 id="app-tiles-title" class="app-c__h2">{@t.tiles_title}</h2>
      <ul class="app-c__grid">
        <li
          :for={{{title, body}, i} <- Enum.with_index(@t.tiles)}
          class={["app-c__tile", i in [0, 5] && "app-c__tile--wide"]}
          data-rise
          style={"--rise-delay: #{i * 60}ms"}
        >
          <div class="app-c__tile-words">
            <span class="app-c__numeral" aria-hidden="true">
              {Enum.at(~w(I II III IV V VI), i)}
            </span>
            <h3 class="app-c__h3">{title}</h3>
            <p>{body}</p>
          </div>
          <.clip
            :if={i == 0}
            name={Map.get(@t.clip_names, "c6-hours", "c6-hours")}
            alt={@t.clips["c6-hours"]}
            pause={@t.pause}
            play={@t.play}
            class="app-phone--tile"
          />
          <.clip
            :if={i == 5}
            name={Map.get(@t.clip_names, "c7-prayers", "c7-prayers")}
            alt={@t.clips["c7-prayers"]}
            pause={@t.pause}
            play={@t.play}
            class="app-phone--tile"
          />
        </li>
      </ul>
    </div>
  </section>

  <section class="app-c__close" aria-labelledby="app-close-title">
    <p class="app-c__kicker">{@t.kicker}</p>
    <h2 id="app-close-title" class="app-c__h2">{@t.close_title}</h2>
    <p>{@t.close_body}</p>
    <.app_store_button href={@app_store_url} free={@t.free} badge={@t.badge} />
  </section>
</div>

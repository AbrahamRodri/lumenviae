<section id="true-and-false" class="mb-20 scroll-mt-8">
  <div class="text-center mb-10">
    <p class="font-cinzel text-rubric text-sm tracking-[0.4em] uppercase mb-3">
      Chapter II
    </p>
    <h2 class="font-ovo text-navy text-4xl md:text-5xl mb-4">
      True and False Devotion
    </h2>
    <p class="font-garamond text-brown text-lg md:text-xl max-w-2xl mx-auto leading-relaxed">
      Before teaching the true devotion, St. Louis unmasks seven counterfeit
      devotions to Our Lady, and then gives five marks by which the genuine
      devotion is known.
    </p>
  </div>

  <div
    class="flex flex-wrap justify-center gap-2 mb-8"
    role="tablist"
    aria-label="True and false devotion"
  >
    <button
      type="button"
      role="tab"
      aria-selected={to_string(@devotion_tab == "false")}
      phx-click="select-devotion-tab"
      phx-value-tab="false"
      class={[
        "px-6 py-2.5 rounded-full font-ovo tracking-wide transition-all duration-300 border",
        if(@devotion_tab == "false",
          do: "bg-navy text-gold border-navy shadow-md",
          else: "bg-white text-navy border-gold/40 hover:border-gold hover:bg-gold-light/20"
        )
      ]}
    >
      The Seven False Devotions
    </button>
    <button
      type="button"
      role="tab"
      aria-selected={to_string(@devotion_tab == "true")}
      phx-click="select-devotion-tab"
      phx-value-tab="true"
      class={[
        "px-6 py-2.5 rounded-full font-ovo tracking-wide transition-all duration-300 border",
        if(@devotion_tab == "true",
          do: "bg-navy text-gold border-navy shadow-md",
          else: "bg-white text-navy border-gold/40 hover:border-gold hover:bg-gold-light/20"
        )
      ]}
    >
      The Five Marks of True Devotion
    </button>
  </div>

  <% {items, citation} =
    if @devotion_tab == "false",
      do: {@false_devotions, "nn. 92–104"},
      else: {@true_marks, "nn. 105–110"} %>

  <div class="max-w-3xl mx-auto space-y-3">
    <%= for {item, index} <- Enum.with_index(items, 1) do %>
      <% expanded? = @expanded_devotion == index %>
      <div class={[
        "bg-white rounded shadow-soft border-l-3 transition-all duration-300",
        cond do
          expanded? and @devotion_tab == "true" -> "border-gold shadow-ornate"
          expanded? -> "border-brown-light shadow-ornate"
          @devotion_tab == "true" -> "border-gold/50 hover:border-gold"
          true -> "border-brown-light/40 hover:border-brown-light"
        end
      ]}>
        <button
          type="button"
          phx-click="toggle-devotion"
          phx-value-index={index}
          aria-expanded={to_string(expanded?)}
          aria-controls={"devotion-desc-#{@devotion_tab}-#{index}"}
          class="w-full flex items-baseline gap-4 p-5 text-left cursor-pointer"
        >
          <span class={[
            "font-ovo text-2xl shrink-0",
            if(@devotion_tab == "true", do: "text-gold-dark", else: "text-brown-light")
          ]}>
            {index}
          </span>
          <span class="font-ovo text-navy text-xl flex-1">{item.name}</span>
          <span class="font-work-sans text-gold-dark text-xs uppercase tracking-wide shrink-0">
            {if expanded?, do: "Hide", else: "Show"}
          </span>
        </button>
        <p
          id={"devotion-desc-#{@devotion_tab}-#{index}"}
          hidden={not expanded?}
          class="px-5 pb-5 pl-14 font-work-sans text-brown leading-[1.7]"
        >
          {item.description}
        </p>
      </div>
    <% end %>
  </div>

  <p class="text-center font-garamond italic text-brown-light mt-6">
    True Devotion to the Blessed Virgin, {citation}
  </p>
</section>

<.admin_page
  active="system"
  title="System"
  subtitle={"The running app: release, database, jobs and the services it depends on. Times in #{LumenViae.CentralTime.abbreviation(@refreshed_at)}."}
  flash={@flash}
>
  <:actions>
    <button type="button" phx-click="refresh" class="admin-btn admin-btn-ghost">
      <span class="hero-arrow-path size-4" aria-hidden="true" /> Refresh
    </button>
    <.link href="/admin/live" class="admin-btn admin-btn-secondary">Live dashboard</.link>
    <.link href="/admin/jobs" class="admin-btn admin-btn-secondary">Jobs</.link>
  </:actions>

  <div class="grid gap-3 grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 mb-6">
    <.metric
      label="Release"
      value={@runtime.version}
      hint={Enum.join(Enum.reject([@runtime.region, to_string(@runtime.node)], &is_nil/1), " · ")}
    />
    <.metric
      label="Up for"
      value={uptime(@runtime.uptime_seconds)}
      hint={"#{length(@runtime.peers)} other machine(s) in the cluster"}
    />
    <.metric
      label="Memory"
      value={bytes(@runtime.memory[:total])}
      hint={"#{@runtime.processes} processes"}
    />
    <.metric
      label="Database"
      value={bytes(@database.size_bytes)}
      hint={"#{@database.connections} of #{@database.max_connections} connections open"}
    />
    <.metric
      label="Jobs waiting"
      value={@totals.waiting}
      hint="Available or scheduled"
      navigate={jobs_path(state: "available")}
    />
    <.metric
      label="Jobs failing"
      value={@totals.failing}
      tone="danger"
      hint="Retrying or discarded"
      navigate={jobs_path(state: "retryable")}
    />
  </div>

  <div class="grid gap-5 xl:grid-cols-3 mb-5 items-start">
    <div class="xl:col-span-2 space-y-5">
      <.panel
        title="Queues"
        description="Every count opens Oban Web on those jobs. Finished jobs are kept for seven days."
        flush
      >
        <div class="overflow-x-auto">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Queue</th>
                <th>Limit</th>
                <th :for={{_state, heading} <- queue_columns()}>{heading}</th>
                <th>Oldest waiting</th>
              </tr>
            </thead>
            <tbody>
              <tr :for={row <- @queues}>
                <td class="font-medium text-admin-ink">{row.queue}</td>
                <td class="text-admin-ink-soft">{row.limit || "not run here"}</td>
                <td :for={{state, _heading} <- queue_columns()}>
                  <% count = Map.get(row.counts, state, 0) %>
                  <.link
                    :if={count > 0}
                    href={jobs_path(state: state, queues: row.queue)}
                    class={[
                      "hover:text-navy",
                      state in ["retryable", "discarded"] && "text-danger-strong font-semibold"
                    ]}
                  >
                    {count}
                  </.link>
                  <span :if={count == 0} class="text-admin-ink-faint">0</span>
                </td>
                <td class="text-admin-ink-soft whitespace-nowrap">
                  {waited(row.oldest_available_at)}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </.panel>

      <.panel
        title="Recent failures"
        description="Jobs waiting to retry, discarded after their last attempt, or cancelled. Newest first."
        flush
      >
        <%= if @failures == [] do %>
          <div class="p-4">
            <.empty_state>Nothing has failed in the last seven days.</.empty_state>
          </div>
        <% else %>
          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>When</th>
                  <th>Job</th>
                  <th>State</th>
                  <th>Attempt</th>
                  <th>Last error</th>
                </tr>
              </thead>
              <tbody>
                <tr :for={job <- @failures}>
                  <td class="text-admin-ink-soft whitespace-nowrap">
                    {format_time(job.attempted_at)}
                  </td>
                  <td>
                    <.link
                      href={job_path(job.id)}
                      class="font-medium text-admin-ink hover:text-navy"
                    >
                      {short(job.worker)}
                    </.link>
                    <p class="text-xs text-admin-ink-faint">{job.queue} · #{job.id}</p>
                  </td>
                  <td>
                    <.admin_badge tone={state_tone(job.state)}>{job.state}</.admin_badge>
                  </td>
                  <td class="text-admin-ink-soft">{job.attempt} / {job.max_attempts}</td>
                  <td class="text-xs text-admin-ink-soft max-w-md truncate" title={job.error}>
                    {job.error || "-"}
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        <% end %>
      </.panel>

      <.panel
        title="Schedule"
        description="The crontab, in UTC on the leader. Run now enqueues the job as the schedule would, earlier."
        flush
      >
        <div
          :if={@schedule != [] and not Enum.any?(@schedule, & &1.running_here?)}
          class="px-4 pt-3"
        >
          <.callout tone="notice">
            The crontab is not running on this machine (development empties it). Run now still
            enqueues the job here.
          </.callout>
        </div>
        <%= if @schedule == [] do %>
          <div class="p-4">
            <.empty_state>Nothing is scheduled.</.empty_state>
          </div>
        <% else %>
          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>When</th>
                  <th>Job</th>
                  <th>Next run</th>
                  <th>Last run</th>
                  <th class="text-right"></th>
                </tr>
              </thead>
              <tbody>
                <tr :for={{entry, index} <- Enum.with_index(@schedule)}>
                  <td class="font-mono text-xs text-admin-ink">{entry.expression}</td>
                  <td class="font-medium text-admin-ink">{short(entry.worker)}</td>
                  <td class="text-admin-ink-soft whitespace-nowrap">
                    {if entry.next_at, do: format_time(entry.next_at), else: "At boot"}
                  </td>
                  <td>
                    <%= if entry.last_run do %>
                      <.link href={job_path(entry.last_run.id)} class="hover:text-navy">
                        <.admin_badge tone={state_tone(entry.last_run.state)}>
                          {entry.last_run.state}
                        </.admin_badge>
                      </.link>
                      <span class="text-xs text-admin-ink-faint ml-1">
                        {format_time(entry.last_run.attempted_at || entry.last_run.inserted_at)}
                      </span>
                    <% else %>
                      <span class="text-admin-ink-faint">Never, in the last seven days</span>
                    <% end %>
                  </td>
                  <td class="text-right">
                    <button
                      :if={index in @runnable}
                      type="button"
                      phx-click="run_job"
                      phx-value-worker={entry.worker}
                      class="admin-btn admin-btn-secondary"
                    >
                      Run now
                    </button>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        <% end %>
      </.panel>
    </div>

    <div class="space-y-5">
      <.panel
        title="Third parties"
        description="Asked once when the page opens, with a timeout each."
      >
        <ul class="divide-y divide-admin-hairline -my-2">
          <li :for={name <- LumenViae.Ops.probe_names()} class="py-2.5">
            <% probe = @probes[name] %>
            <div class="flex items-center justify-between gap-2">
              <span class="font-medium text-admin-ink">{probe_label(name)}</span>
              <.admin_badge tone={probe_tone(probe)}>{probe_status(probe)}</.admin_badge>
            </div>
            <p :if={probe != :checking} class="text-xs text-admin-ink-soft mt-0.5 break-words">
              {probe.detail}<span :if={probe.ms} class="text-admin-ink-faint"> · {probe.ms} ms</span>
            </p>
          </li>
        </ul>
      </.panel>

      <.panel
        title="Office cache"
        description="Parsed offices held on each machine, and the job that warms them."
      >
        <:actions>
          <button
            type="button"
            phx-click="clear_office_cache"
            data-confirm="Empty the Office cache on every machine? The next request for each office will wait on the engine."
            class="admin-btn admin-btn-ghost"
          >
            Empty
          </button>
        </:actions>
        <dl class="space-y-1.5 text-[0.8125rem]">
          <div :for={{node, stats} <- @office.machines} class="flex justify-between gap-2">
            <dt class="text-admin-ink-soft truncate">{node}</dt>
            <dd class="text-admin-ink whitespace-nowrap">
              <%= case stats do %>
                <% {:error, _reason} -> %>
                  <span class="text-danger-strong">did not answer</span>
                <% stats -> %>
                  {stats.entries} entries · {bytes(stats.bytes)}
              <% end %>
            </dd>
          </div>
        </dl>
        <div class="mt-3 pt-3 border-t border-admin-hairline text-[0.8125rem]">
          <p class="admin-eyebrow mb-1">Last warm</p>
          <%= if @office.last_warm do %>
            <.link href={job_path(@office.last_warm.id)} class="hover:text-navy">
              <.admin_badge tone={state_tone(@office.last_warm.state)}>
                {@office.last_warm.state}
              </.admin_badge>
            </.link>
            <span class="text-xs text-admin-ink-faint ml-1">
              {format_time(@office.last_warm.completed_at || @office.last_warm.attempted_at)}
            </span>
            <p :if={@office.last_warm.error} class="text-xs text-danger-strong mt-1 break-words">
              {@office.last_warm.error}
            </p>
          <% else %>
            <span class="text-admin-ink-faint">No warm in the last seven days.</span>
          <% end %>
        </div>
      </.panel>

      <.panel title="Database" description={"PostgreSQL #{@database.server_version}"}>
        <dl class="grid grid-cols-2 gap-2 mb-3">
          <div>
            <dt class="admin-eyebrow">Pool</dt>
            <dd class="text-lg font-semibold text-admin-ink">{@database.pool_size}</dd>
          </div>
          <div>
            <dt class="admin-eyebrow">Cache hits</dt>
            <dd class="text-lg font-semibold text-admin-ink">
              {percent(@database.cache_hit_ratio)}
            </dd>
          </div>
        </dl>
        <p class="admin-eyebrow mb-1">Largest tables</p>
        <dl class="space-y-1 text-[0.8125rem]">
          <div :for={table <- @database.tables} class="flex justify-between gap-2">
            <dt class="text-admin-ink-soft truncate">{table.name}</dt>
            <dd class="text-admin-ink whitespace-nowrap">
              {bytes(table.bytes)}
              <span class="text-admin-ink-faint">· ~{table.rows} rows</span>
            </dd>
          </div>
        </dl>
      </.panel>

      <.panel title="Runtime">
        <dl class="space-y-1 text-[0.8125rem]">
          <div class="flex justify-between gap-2">
            <dt class="text-admin-ink-soft">Elixir / OTP</dt>
            <dd class="text-admin-ink">{@runtime.elixir} / {@runtime.otp}</dd>
          </div>
          <div class="flex justify-between gap-2">
            <dt class="text-admin-ink-soft">Processes</dt>
            <dd class="text-admin-ink">{@runtime.processes} of {@runtime.process_limit}</dd>
          </div>
          <div class="flex justify-between gap-2">
            <dt class="text-admin-ink-soft">Schedulers · run queue</dt>
            <dd class="text-admin-ink">{@runtime.schedulers} · {@runtime.run_queue}</dd>
          </div>
          <div
            :for={kind <- [:processes, :binary, :ets, :code, :atom]}
            class="flex justify-between gap-2"
          >
            <dt class="text-admin-ink-soft">Memory: {kind}</dt>
            <dd class="text-admin-ink">{bytes(@runtime.memory[kind])}</dd>
          </div>
          <div :if={@runtime.peers != []} class="flex justify-between gap-2">
            <dt class="text-admin-ink-soft">Peers</dt>
            <dd class="text-admin-ink truncate">{Enum.join(@runtime.peers, ", ")}</dd>
          </div>
          <div :if={@runtime.machine} class="flex justify-between gap-2">
            <dt class="text-admin-ink-soft">Machine</dt>
            <dd class="text-admin-ink truncate">{@runtime.machine}</dd>
          </div>
        </dl>
      </.panel>
    </div>
  </div>
</.admin_page>

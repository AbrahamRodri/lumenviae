<.admin_page
  active="import"
  title="Import from CSV"
  subtitle="Upload, review the preview, then run the import with live progress."
  flash={@flash}
  max_width="max-w-5xl"
>
  <%= if @stage == :idle do %>
    <details class="mb-5 bg-admin-surface border border-admin-hairline rounded-lg shadow-admin">
      <summary class="cursor-pointer px-4 py-3 text-[0.9375rem] font-semibold text-admin-ink">
        CSV format reference
      </summary>
      <div class="px-4 pb-4 text-[0.8125rem] text-admin-ink-soft">
        <ul class="list-disc list-inside mt-2 space-y-1">
          <li>
            <strong>mystery_name</strong>
            (required) - exact mystery name (e.g., "The Annunciation")
          </li>
          <li>
            <strong>content</strong>
            (required) - the meditation text, verbatim, with paragraph breaks. Inline {"{pause:N}"} markers (N in seconds, max 3) tune the narration pause at that spot and are stripped before saving; a marker alone between two paragraphs replaces that paragraph break's default pause.
          </li>
          <li><strong>title</strong> (optional) - meditation title</li>
          <li><strong>author</strong> (optional) - e.g., "Blessed Anne Catherine Emmerich"</li>
          <li><strong>source</strong> (optional) - the public domain edition quoted</li>
          <li>
            <strong>audio_filename</strong>
            (optional) - S3 key; audio is generated with ElevenLabs when present
          </li>
          <li>
            <strong>set_name</strong>
            (optional) - attach to this meditation set, creating it if needed
          </li>
          <li>
            <strong>set_category</strong>
            (required for new sets) - joyful, sorrowful, glorious, luminous, seven_sorrows
          </li>
          <li><strong>set_description</strong> (optional) - used when the set is created</li>
          <li>
            <strong>set_labels</strong>
            (optional) - pipe-separated, from: {Enum.join(@label_vocabulary, ", ")}. First label is the primary group. Maximum 3.
          </li>
          <li>
            <strong>order</strong> (optional) - position within the set; omitted rows are appended
          </li>
        </ul>
        <p class="mt-3 text-admin-ink-faint">
          Content rules live in docs/MEDITATION_CURATION_GUIDE.md. Generated CSVs belong in priv/repo/imports/.
        </p>
      </div>
    </details>

    <form phx-submit="preview" phx-change="validate" class="mb-5">
      <div class="bg-admin-surface border border-dashed border-admin-hairline-strong rounded-lg p-8 text-center">
        <.live_file_input upload={@uploads.csv} class="hidden" />

        <div class="space-y-4">
          <%= for entry <- @uploads.csv.entries do %>
            <div class="flex items-center justify-between bg-admin-sunken p-3 rounded">
              <div class="flex items-center space-x-3">
                <svg
                  class="h-7 w-7 text-admin-ink-faint"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                  />
                </svg>
                <div class="text-left">
                  <p class="font-medium text-admin-ink">{entry.client_name}</p>
                  <p class="text-xs text-admin-ink-faint">{entry.progress}%</p>
                </div>
              </div>
              <button
                type="button"
                phx-click="remove-upload"
                phx-value-ref={entry.ref}
                class="admin-btn admin-btn-ghost"
              >
                Remove
              </button>
            </div>
          <% end %>

          <%= if @uploads.csv.entries == [] do %>
            <label for={@uploads.csv.ref} class="cursor-pointer">
              <div class="flex flex-col items-center">
                <svg
                  class="h-10 w-10 text-admin-ink-faint mb-3"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
                  />
                </svg>
                <span class="text-[0.8125rem] font-medium text-admin-ink">
                  Click to choose a CSV, or drop one here
                </span>
                <span class="text-xs text-admin-ink-faint mt-1">CSV files only</span>
              </div>
            </label>
          <% end %>
        </div>

        <%= for error <- upload_errors(@uploads.csv) do %>
          <p class="text-danger-strong text-xs mt-2">{error_to_string(error)}</p>
        <% end %>
      </div>

      <.callout :if={@preview_error} tone="danger">{@preview_error}</.callout>

      <%= if @uploads.csv.entries != [] do %>
        <div class="mt-4 flex justify-end gap-2">
          <.link navigate="/admin" class="admin-btn admin-btn-ghost">Cancel</.link>
          <button type="submit" class="admin-btn admin-btn-primary">Preview import</button>
        </div>
      <% end %>
    </form>
  <% end %>

  <%= if @stage == :ready and @preview do %>
    <div class="grid gap-3 grid-cols-2 lg:grid-cols-4 mb-5">
      <.metric label="Rows" value={@preview.total} hint={@csv_filename} />
      <.metric
        label="Valid"
        value={"#{@preview.valid_count} / #{@preview.total}"}
        tone={if @preview.error_count == 0, do: "neutral", else: "danger"}
        hint={"#{@preview.error_count} with errors"}
      />
      <.metric
        label="Audio clips"
        value={@preview.audio_count}
        hint={if @skip_audio, do: "Skipped", else: "Will be generated"}
      />
      <.metric label="New sets" value={length(@preview.new_sets)} hint="Created by this import" />
    </div>

    <.callout :if={@preview.new_sets != []} tone="notice">
      Will create set(s): <strong>{Enum.join(@preview.new_sets, ", ")}</strong>
    </.callout>
    <.callout :if={@preview.existing_sets != []} tone="notice">
      Appending to existing set(s): <strong>{Enum.join(@preview.existing_sets, ", ")}</strong>
    </.callout>

    <.panel flush class="mb-5">
      <:actions>
        <button phx-click="reset" class="admin-btn admin-btn-ghost">
          Choose a different file
        </button>
      </:actions>
      <div class="overflow-x-auto">
        <table class="admin-table">
          <thead>
            <tr>
              <th class="w-8">#</th>
              <th>Mystery</th>
              <th>Title</th>
              <th>Content</th>
              <th>Audio</th>
              <th>Set / order</th>
            </tr>
          </thead>
          <tbody>
            <%= for row <- @preview.rows do %>
              <tr class={if row.errors != [], do: "bg-danger-surface"}>
                <td class="text-admin-ink-faint">{row.index}</td>
                <td>
                  <span class={
                    if row.mystery_ok,
                      do: "font-medium text-admin-ink",
                      else: "font-medium text-danger-strong"
                  }>
                    {row.mystery_name || "(missing)"}
                  </span>
                </td>
                <td class="text-admin-ink-soft">{row.title}</td>
                <td class="text-admin-ink-soft max-w-md">
                  <p>{row.content_excerpt}</p>
                  <p class="text-xs text-admin-ink-faint mt-1">
                    {row.content_chars} chars, {row.paragraphs} paragraph(s)
                  </p>
                  <%= for warning <- row.warnings do %>
                    <p class="text-xs text-caution-strong mt-1">Warning: {warning}</p>
                  <% end %>
                  <%= for error <- row.errors do %>
                    <p class="text-xs text-danger-strong mt-1 font-semibold">Error: {error}</p>
                  <% end %>
                </td>
                <td>
                  <.admin_badge :if={row.audio_filename} tone="gold">
                    {row.audio_filename}
                  </.admin_badge>
                  <span :if={is_nil(row.audio_filename)} class="text-admin-ink-faint">
                    &mdash;
                  </span>
                </td>
                <td>
                  <%= if row.set_name do %>
                    <p class="text-admin-ink">{row.set_name}</p>
                    <p class="text-xs text-admin-ink-faint">
                      order {row.order || "auto"}
                      <%= if row.set_status == :new do %>
                        (new set<%= if row.set_labels != [] do %>
                          : {Enum.join(row.set_labels, ", ")}
                        <% end %>)
                      <% end %>
                    </p>
                  <% else %>
                    <span class="text-admin-ink-faint">&mdash;</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </.panel>

    <.panel>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <label class="flex items-center gap-2 text-[0.8125rem] text-admin-ink cursor-pointer">
          <input
            type="checkbox"
            checked={@skip_audio}
            phx-click="toggle-skip-audio"
            class="size-3.5 accent-navy"
          />
          <span>
            Skip audio generation
            <span class="text-admin-ink-faint">
              (text only; no ElevenLabs credits, no S3 uploads)
            </span>
          </span>
        </label>

        <div class="flex gap-2">
          <button phx-click="reset" class="admin-btn admin-btn-ghost">Cancel</button>
          <button phx-click="start-import" class="admin-btn admin-btn-primary">
            <%= if @preview.error_count > 0 do %>
              Import {@preview.valid_count} valid row(s)
            <% else %>
              Start import
            <% end %>
          </button>
        </div>
      </div>

      <p
        :if={@preview.audio_count > 0 and not @skip_audio}
        class="text-xs text-caution-strong mt-3 pt-3 border-t border-admin-hairline"
      >
        {@preview.audio_count} audio clip(s) will be generated with ElevenLabs and uploaded to S3.
        This spends credits and takes roughly 10-60 seconds per clip.
      </p>
    </.panel>
  <% end %>

  <%= if @stage in [:importing, :done] do %>
    <.panel class="mb-5">
      <div class="flex items-center justify-between mb-2">
        <h2 class="text-[0.9375rem] font-semibold text-admin-ink">
          <%= if @stage == :importing do %>
            Importing {@csv_filename}
          <% else %>
            <%= if @cancelled do %>
              Import cancelled
            <% else %>
              Import complete
            <% end %>
          <% end %>
        </h2>
        <span class="text-xs text-admin-ink-faint">{format_elapsed(@elapsed)} elapsed</span>
      </div>

      <div class="w-full bg-admin-sunken rounded-full h-2 overflow-hidden mb-2">
        <div
          class={"h-2 rounded-full transition-all duration-500 " <> if(@stage == :done and not @cancelled, do: "bg-positive", else: "bg-navy")}
          style={"width: #{percent(@progress)}%"}
        >
        </div>
      </div>
      <div class="flex items-center justify-between text-xs text-admin-ink-soft mb-4">
        <span>{@progress.done} of {@progress.total} rows processed ({percent(@progress)}%)</span>
        <%= if @stage == :importing do %>
          <button
            phx-click="cancel-import"
            data-confirm="Stop the import? Rows already created will remain in the database."
            class="admin-btn admin-btn-danger"
          >
            Stop import
          </button>
        <% end %>
      </div>

      <%= if @current_activity do %>
        <div class="flex items-center gap-2 text-[0.8125rem] text-admin-ink bg-admin-sunken border border-admin-hairline rounded p-3 mb-4">
          <svg class="h-4 w-4 animate-spin text-navy" fill="none" viewBox="0 0 24 24">
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"
            >
            </circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          <span>{@current_activity}</span>
        </div>
      <% end %>

      <%= if @preview do %>
        <ul class="divide-y divide-admin-hairline">
          <%= for row <- @preview.rows do %>
            <li class="py-2 flex items-start justify-between">
              <div class="flex items-center gap-3 min-w-0">
                <span class="text-admin-ink-faint text-xs w-6 shrink-0">{row.index}</span>
                <div class="min-w-0">
                  <p class="text-[0.8125rem] font-medium text-admin-ink">
                    {row.mystery_name}
                    <%= if row.title do %>
                      - {row.title}
                    <% end %>
                  </p>
                  <%= case row_status(@rows_status, row.index) do %>
                    <% {:ok, message} -> %>
                      <p class="text-xs text-positive-strong truncate">{message}</p>
                    <% {:warning, message} -> %>
                      <p class="text-xs text-caution-strong">{message}</p>
                    <% {:error, message} -> %>
                      <p class="text-xs text-danger-strong">{message}</p>
                    <% {:audio, filename} -> %>
                      <p class="text-xs text-notice">Generating audio: {filename}</p>
                    <% _ -> %>
                  <% end %>
                </div>
              </div>
              <% {badge_class, badge_text} = status_badge(row_status(@rows_status, row.index)) %>
              <span class={"shrink-0 text-[0.6875rem] px-1.5 py-0.5 rounded font-medium " <> badge_class}>
                {badge_text}
              </span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </.panel>

    <%= if @stage == :done do %>
      <div class="space-y-4">
        <div class="grid gap-3 grid-cols-3">
          <.metric label="Created" value={length(@successes)} hint="Written to the database" />
          <.metric
            label="With warnings"
            value={length(@warnings)}
            tone="caution"
            hint="Created, but worth checking"
          />
          <.metric label="Failed" value={length(@errors)} tone="danger" hint="Not created" />
        </div>

        <.callout :if={@cancelled}>
          The import was stopped early. Rows marked Done above were already written to the
          database and remain there; unprocessed rows were not imported.
        </.callout>

        <.panel :if={@errors != []} title="Errors">
          <ul class="list-disc list-inside text-[0.8125rem] text-danger-strong max-h-60 overflow-y-auto">
            <%= for {:error, message} <- @errors do %>
              <li>{message}</li>
            <% end %>
          </ul>
        </.panel>

        <.panel
          :if={@warnings != []}
          title="Created with warnings"
          description="Worth opening these to check."
        >
          <ul class="list-disc list-inside text-[0.8125rem] text-caution-strong max-h-60 overflow-y-auto">
            <%= for {:warning, message} <- @warnings do %>
              <li>{message}</li>
            <% end %>
          </ul>
        </.panel>

        <div class="flex justify-end gap-2">
          <button phx-click="reset" class="admin-btn admin-btn-ghost">Import another file</button>
          <.link navigate="/admin/meditations" class="admin-btn admin-btn-secondary">
            View all meditations
          </.link>
          <.link navigate="/admin" class="admin-btn admin-btn-primary">Back to dashboard</.link>
        </div>
      </div>
    <% end %>
  <% end %>
</.admin_page>

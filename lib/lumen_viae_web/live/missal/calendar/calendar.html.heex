<div class="missal-page min-h-screen pb-16" id="missal-calendar" phx-hook="UserTimezone">
  <Layouts.flash_group flash={@flash} variant={:public} />

  <section class="max-w-5xl mx-auto px-4 sm:px-8 pt-6 md:pt-10" aria-labelledby="calendar-heading">
    <.link
      navigate={Days.back_path(@day, @language)}
      class="btn-text !text-ink-muted hover:!text-gilt-light -ml-1"
      data-role="back"
    >
      <span class="hero-chevron-left size-3.5" aria-hidden="true" /> The Mass
    </.link>

    <p class="kicker text-center mt-4">Choose a day</p>
    <div class="hours-month-head mt-2">
      <.link
        :if={@previous}
        patch={@previous}
        class="hours-month-step"
        aria-label="Previous month"
        data-role="previous-month"
      >
        <span class="hero-chevron-left size-4" aria-hidden="true" />
      </.link>
      <span :if={!@previous} class="hours-month-step" aria-hidden="true"></span>
      <h1 id="calendar-heading" class="hours-month-title">{@title}</h1>
      <.link
        :if={@next}
        patch={@next}
        class="hours-month-step"
        aria-label="Next month"
        data-role="next-month"
      >
        <span class="hero-chevron-right size-4" aria-hidden="true" />
      </.link>
      <span :if={!@next} class="hours-month-step" aria-hidden="true"></span>
    </div>
    <.sacred_divider class="!my-4 max-w-[160px] mx-auto" />

    <p :if={@state == :loading} class="sr-only" aria-live="polite">Loading the month</p>
    <div :if={@state == :failed} class="text-center mb-4" role="alert" data-role="calendar-failed">
      <p class="hours-quiet">
        The calendar could not be reached from Missale Meum. Every day still opens.
      </p>
      <button type="button" phx-click="retry" class="btn-text" data-role="retry">
        <span class="hero-arrow-path size-3.5" aria-hidden="true" /> Try again
      </button>
    </div>

    <div class="hours-month" data-role="month">
      <div class="hours-month__week" aria-hidden="true">
        <span :for={letter <- @weekdays} class="hours-month__weekday">{letter}</span>
      </div>
      <div :for={week <- Enum.chunk_every(@cells, 7)} class="hours-month__week">
        <span :for={date <- week} class="min-w-0">
          <.link
            :if={date}
            navigate={Days.day_path(date, @language)}
            class="hours-day"
            aria-current={if(date == @today, do: "date")}
            aria-label={spoken(date, @days[date])}
            data-role="day-cell"
            data-date={Date.to_iso8601(date)}
          >
            <span class="hours-day__number">{date.day}</span>
            <span
              class={[
                "missal-silk missal-silk--day",
                Days.vestment(@days[date]) && "missal-silk--#{Days.vestment(@days[date]).letter}"
              ]}
              aria-hidden="true"
              data-role={Days.vestment(@days[date]) && "vestment"}
            ></span>
            <span :if={@days[date]} class="hours-day__title" aria-hidden="true">
              {@days[date].title}
            </span>
          </.link>
        </span>
      </div>
    </div>

    <div
      :if={today_shown?(@today, @year, @month, @days)}
      class="hours-today-line md:hidden"
      data-role="today-line"
    >
      <p class="kicker !text-[0.75rem] opacity-80">{Days.long_date(@today)}</p>
      <p class="hours-feast !text-lg">{@days[@today].title}</p>
    </div>

    <p class="hours-credit mt-10">
      <a href={Days.credit_url()} class="hours-credit__link" rel="noopener" target="_blank">
        {Days.credit()}
      </a>
    </p>
  </section>
</div>

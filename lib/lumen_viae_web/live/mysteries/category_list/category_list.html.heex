<div class="min-h-screen bg-parchment">
  <!-- Category Hero -->
  <section
    class="relative bg-navy overflow-hidden border-b-3 border-gold"
    aria-labelledby="category-heading"
  >
    <div class="absolute inset-0 opacity-[0.05]" aria-hidden="true">
      <img src="/images/ornate-blue-gold-bg-symbols.jpg" alt="" class="w-full h-full object-cover" />
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-navy-dark/50 via-transparent to-navy-dark/70"
      aria-hidden="true"
    >
    </div>

    <div class="relative max-w-4xl mx-auto px-8 py-16 text-center">
      <p class="font-cinzel text-xs tracking-[0.35em] uppercase text-gold-light/70 mb-4 animate-rise">
        The Holy Rosary
      </p>

      <h1
        id="category-heading"
        class="font-cinzel text-4xl md:text-6xl text-cream mb-4 animate-rise"
        style="animation-delay: 120ms"
      >
        {category_title(@category)}
      </h1>

      <p
        class="font-cinzel text-sm tracking-[0.25em] uppercase text-gold mb-2 animate-rise"
        style="animation-delay: 200ms"
      >
        {category_days(@category)}
      </p>

      <.sacred_divider
        class="max-w-[210px] mx-auto animate-rise"
        style="animation-delay: 240ms"
      />

      <% {epigraph, reference} = category_epigraph(@category) %>
      <div class="max-w-2xl mx-auto animate-rise" style="animation-delay: 280ms">
        <p class="font-garamond text-xl md:text-2xl text-gold-light italic leading-relaxed">
          "{epigraph}"
        </p>
        <p class="font-cinzel text-xs tracking-[0.3em] uppercase text-gold-light/60 mt-3">
          {reference}
        </p>
      </div>
    </div>
  </section>

  <!-- Meditation Sets -->
  <section class="max-w-5xl mx-auto px-8 py-16" aria-labelledby="sets-heading">
    <%= if @meditation_sets == [] do %>
      <div class="max-w-2xl mx-auto hairline-card ornate-corners px-8 py-14 text-center">
        <span class="font-cinzel text-gold text-xl block mb-4" aria-hidden="true">&#10022;</span>
        <p class="font-garamond text-xl text-navy italic mb-4">
          No meditation sets are available yet for {category_title(@category)}.
        </p>
        <p class="font-garamond text-brown-light text-base">
          New meditation sets are added regularly. In the meantime, you may pray
          with the scriptures of these mysteries.
        </p>
        <div class="mt-8">
          <.gold_cta navigate="/mysteries">
            Read the Scriptures
          </.gold_cta>
        </div>
      </div>
    <% else %>
      <div class="text-center mb-12">
        <h2 id="sets-heading" class="font-cinzel text-3xl md:text-4xl text-navy mb-3">
          Choose Your Meditations
        </h2>
        <p class="font-garamond text-lg text-brown max-w-2xl mx-auto mb-8">
          Each set contemplates the same mysteries through a different spiritual
          light. Choose the one that speaks to this season of your life.
        </p>

        <.gold_cta type="button" phx-click="random_set">
          Divine Providence
        </.gold_cta>
        <p class="font-cinzel text-[0.65rem] tracking-[0.2em] uppercase text-brown-light mt-3">
          Let a set be chosen for you
        </p>
      </div>

      <div class="flex items-center gap-6 justify-center mb-10 text-gold-dark">
        <div class="h-px w-16 bg-gold/40"></div>
        <span class="font-cinzel text-xs tracking-[0.35em] uppercase">or choose yourself</span>
        <div class="h-px w-16 bg-gold/40"></div>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <%= for set <- @meditation_sets do %>
          <%= if LumenViae.Rosary.Artwork.publishable?(set) do %>
            <.link
              navigate={"/meditation-sets/#{set.id}/pray"}
              class="group relative flex flex-col justify-end min-h-[24rem] rounded-2xl border border-gold/35 shadow-soft overflow-hidden hover:shadow-ornate hover:-translate-y-1 active:scale-[0.98] transition-all duration-300"
            >
              <img
                src={Rosary.artwork_url(set)}
                alt={set.image_alt}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
                style={"object-position: #{LumenViae.Rosary.Artwork.object_position(set.image_focal_x, set.image_focal_y)}"}
              />
              <div
                class="absolute inset-0 bg-gradient-to-b from-transparent via-navy/20 to-navy/70"
                aria-hidden="true"
              >
              </div>

              <div class="relative p-8">
                <h3 class="font-cinzel text-2xl text-cream mb-3 pr-4">
                  {set.name}
                </h3>

                <%= if has_audio?(set) do %>
                  <div class="mb-4">
                    <span class="inline-flex items-center gap-1.5 font-cinzel text-[0.65rem] tracking-[0.2em] uppercase text-gold-light border border-gold/45 bg-navy-dark/55 px-3 py-1 rounded-full">
                      <svg viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3" aria-hidden="true">
                        <path d="M12 2C6.477 2 2 6.477 2 12v4a2 2 0 002 2h2a2 2 0 002-2v-3a2 2 0 00-2-2H4.062A8.001 8.001 0 0112 4a8.001 8.001 0 017.938 7H18a2 2 0 00-2 2v3a2 2 0 002 2h2a2 2 0 002-2v-4c0-5.523-4.477-10-10-10z" />
                      </svg>
                      Guided Audio
                    </span>
                  </div>
                <% end %>

                <%= if set.description do %>
                  <p class="font-garamond text-lg text-cream/90 leading-relaxed mb-5">
                    {set.description}
                  </p>
                <% end %>

                <span class="font-cinzel text-[0.7rem] tracking-[0.15em] uppercase text-gold-light group-hover:text-gold transition-colors">
                  Begin Prayer
                  <span
                    class="inline-block transition-transform duration-300 group-hover:translate-x-1"
                    aria-hidden="true"
                  >
                    &rarr;
                  </span>
                </span>
              </div>
            </.link>
          <% else %>
            <.link
              navigate={"/meditation-sets/#{set.id}/pray"}
              class="group relative flex flex-col hairline-card p-8 overflow-hidden hover:shadow-ornate hover:-translate-y-1 active:scale-[0.98] transition-all duration-300"
            >
              <h3 class="font-cinzel text-2xl text-navy mb-3 pr-4">
                {set.name}
              </h3>

              <%= if has_audio?(set) do %>
                <div class="mb-4">
                  <span class="inline-flex items-center gap-1.5 font-cinzel text-[0.65rem] tracking-[0.2em] uppercase text-navy bg-gold/90 px-3 py-1 rounded-full">
                    <svg viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3" aria-hidden="true">
                      <path d="M12 2C6.477 2 2 6.477 2 12v4a2 2 0 002 2h2a2 2 0 002-2v-3a2 2 0 00-2-2H4.062A8.001 8.001 0 0112 4a8.001 8.001 0 017.938 7H18a2 2 0 00-2 2v3a2 2 0 002 2h2a2 2 0 002-2v-4c0-5.523-4.477-10-10-10z" />
                    </svg>
                    Guided Audio
                  </span>
                </div>
              <% end %>

              <%= if set.description do %>
                <p class="font-garamond text-lg text-brown leading-relaxed mb-6 grow">
                  {set.description}
                </p>
              <% else %>
                <div class="grow"></div>
              <% end %>

              <span class="font-cinzel text-[0.7rem] tracking-[0.15em] uppercase text-gold-dark group-hover:text-gold transition-colors">
                Begin Prayer
                <span
                  class="inline-block transition-transform duration-300 group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  &rarr;
                </span>
              </span>
            </.link>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <!-- Back to Home -->
    <div class="mt-14 text-center">
      <.link
        navigate="/"
        class="inline-flex items-center gap-2 font-cinzel text-[0.7rem] tracking-[0.15em] uppercase text-gold-dark hover:text-gold transition-colors"
      >
        <span aria-hidden="true">&larr;</span> Return to All Mysteries
      </.link>
    </div>
  </section>
</div>

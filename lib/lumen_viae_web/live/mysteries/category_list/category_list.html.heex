<div class="category-page min-h-screen pb-16">
  <.category_hero
    category={@category}
    title={@title}
    subtitle={@subtitle}
    days={@days}
    painting={@painting}
  />

  <.mysteries_list category={@category} mysteries={@mysteries} />

  <div class="max-w-5xl mx-auto px-4 sm:px-8 pt-8 md:pt-12 grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-12 items-start">
    <div class="min-w-0 lg:col-start-2 lg:row-start-1 lg:sticky lg:top-6">
      <.rosary_choices choices={@choices} voices={@voices} />
    </div>

    <div class="lg:col-start-1 lg:row-start-1 min-w-0 space-y-8">
      <.ways_to_pray category={@category} choices={@choices} />

      <.shelf
        title={@title}
        sets={@meditation_sets}
        shown_sets={@shown_sets}
        filters={@filters}
        kinds_offered={@kinds_offered}
        choices={@choices}
      />
    </div>
  </div>

  <div class="mt-14 text-center px-4">
    <.link navigate="/" class="btn-text !text-ink-muted hover:!text-gilt">
      <span aria-hidden="true">&lsaquo;</span> All the mysteries
    </.link>
  </div>
</div>

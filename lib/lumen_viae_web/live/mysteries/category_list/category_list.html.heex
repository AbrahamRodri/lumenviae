<div class="category-page min-h-screen bg-parchment pb-16">
  <.category_hero
    category={@category}
    title={@title}
    subtitle={@subtitle}
    days={@days}
    painting={@painting}
  />

  <.mysteries_list category={@category} mysteries={@mysteries} />

  <div class="max-w-5xl mx-auto px-4 sm:px-8 pt-10 md:pt-14 grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-12 items-start">
    <div class="lg:col-start-2 lg:row-start-1 lg:sticky lg:top-6">
      <.rosary_choices choices={@choices} voices={@voices} />
    </div>

    <div class="lg:col-start-1 lg:row-start-1 min-w-0 space-y-10">
      <.ways_to_pray category={@category} choices={@choices} />

      <.shelf
        title={@title}
        sets={@meditation_sets}
        shown_sets={@shown_sets}
        filters={@filters}
        kinds_offered={@kinds_offered}
        choices={@choices}
      />
    </div>
  </div>

  <div class="mt-14 text-center px-4">
    <.link
      navigate="/"
      class="inline-flex items-center gap-2 min-h-11 px-2 font-cinzel text-[0.7rem] tracking-[0.15em] uppercase text-gold-dark hover:text-navy transition-colors"
    >
      <span aria-hidden="true">&larr;</span> Return to All Mysteries
    </.link>
  </div>
</div>

<.admin_page
  active="mysteries"
  title="Mysteries"
  subtitle="The mysteries of the Rosary and the Seven Sorrows that meditations attach to."
  flash={@flash}
>
  <:actions>
    <.link navigate="/admin/mysteries/new" class="admin-btn admin-btn-primary">
      New mystery
    </.link>
  </:actions>

  <div class="grid gap-3 grid-cols-2 lg:grid-cols-3 mb-5">
    <.metric label="Mysteries" value={length(@mysteries)} hint="Across all five categories" />
    <.metric
      label="Without a meditation"
      value={@bare_count}
      tone="caution"
      hint="Nothing active written for them yet"
    />
    <.metric
      label="Categories"
      value={length(@grouped_mysteries)}
      hint="Showing in the current filter"
    />
  </div>

  <.panel class="mb-5">
    <.form for={%{}} phx-change="update_filters">
      <div class="grid gap-3 grid-cols-2 md:grid-cols-4">
        <.filter_search
          name="q"
          label="Search"
          value={@filters.query}
          placeholder="Name, description, or scripture"
        />
        <.filter_select
          name="category"
          label="Category"
          value={@filters.category}
          prompt="All"
          options={@mystery_categories}
        />
      </div>
    </.form>

    <.filter_summary
      shown={@filtered_count}
      total={length(@mysteries)}
      noun="mysteries"
      filtered={filters_applied?(@filters)}
    />
  </.panel>

  <%= if @grouped_mysteries == [] do %>
    <.panel>
      <.empty_state>No mysteries match these filters.</.empty_state>
    </.panel>
  <% else %>
    <div class="space-y-5">
      <.panel :for={{label, mysteries} <- @grouped_mysteries} title={label} flush>
        <div class="overflow-x-auto">
          <table class="admin-table">
            <thead>
              <tr>
                <th class="w-10">#</th>
                <th>Mystery</th>
                <th>Scripture</th>
                <th>Prayed on</th>
                <th>Meditations</th>
                <th class="text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              <tr :for={mystery <- mysteries}>
                <td class="text-admin-ink-faint">{mystery.order}</td>
                <td>
                  <.link
                    navigate={"/admin/mysteries/#{mystery.id}/edit"}
                    class="font-medium text-admin-ink hover:text-navy"
                  >
                    {mystery.name}
                  </.link>
                  <p
                    :if={mystery.description}
                    class="text-xs text-admin-ink-faint truncate max-w-md"
                  >
                    {mystery.description}
                  </p>
                </td>
                <td class="text-admin-ink-soft">
                  {mystery.scripture_reference || "—"}
                </td>
                <td class="text-admin-ink-soft">{mystery.days_prayed || "—"}</td>
                <td>
                  <.admin_badge
                    :if={meditation_count(@active_counts, mystery.id) == 0}
                    tone="amber"
                  >
                    None
                  </.admin_badge>
                  <span :if={meditation_count(@active_counts, mystery.id) > 0}>
                    <span class="font-medium text-admin-ink">
                      {meditation_count(@active_counts, mystery.id)}
                    </span>
                    <span
                      :if={
                        meditation_count(@meditation_counts, mystery.id) >
                          meditation_count(@active_counts, mystery.id)
                      }
                      class="text-admin-ink-faint"
                      title="Active, of the total including archived"
                    >
                      of {meditation_count(@meditation_counts, mystery.id)}
                    </span>
                  </span>
                </td>
                <td>
                  <div class="flex items-center justify-end gap-1">
                    <.link
                      navigate={"/admin/meditations?mystery=#{mystery.id}"}
                      class="admin-btn admin-btn-secondary"
                    >
                      Meditations
                    </.link>
                    <.link
                      navigate={"/admin/mysteries/#{mystery.id}/edit"}
                      class="admin-btn admin-btn-secondary"
                    >
                      Edit
                    </.link>
                    <button
                      type="button"
                      phx-click="delete_mystery"
                      phx-value-id={mystery.id}
                      data-confirm={"Delete \"#{mystery.name}\"? Every meditation attached to it is deleted too."}
                      class="admin-btn admin-btn-danger"
                      aria-label={"Delete #{mystery.name}"}
                    >
                      <span class="hero-trash size-3.5" aria-hidden="true" />
                    </button>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </.panel>
    </div>
  <% end %>
</.admin_page>

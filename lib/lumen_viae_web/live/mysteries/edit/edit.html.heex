<.admin_page
  active="mysteries"
  title="Edit mystery"
  subtitle={"#{@mystery.name} · #{LumenViae.Rosary.Categories.label(@mystery.category)} #{@mystery.order}"}
  flash={@flash}
  max_width="max-w-3xl"
>
  <:actions>
    <.link
      navigate={"/admin/meditations?mystery=#{@mystery.id}"}
      class="admin-btn admin-btn-secondary"
    >
      Its meditations
    </.link>
    <.link navigate={@return_to} class="admin-btn admin-btn-secondary">Back to list</.link>
  </:actions>

  <.form for={@edit_form} phx-submit="update_mystery">
    <.panel>
      <div class="space-y-4">
        <.field label="Name" required errors={@edit_form[:name].errors}>
          <input
            type="text"
            name={@edit_form[:name].name}
            value={@edit_form[:name].value || ""}
            required
            class="admin-input"
            placeholder="e.g. The Annunciation"
          />
        </.field>

        <div class="grid md:grid-cols-2 gap-4">
          <.field label="Category" required errors={@edit_form[:category].errors}>
            <select name={@edit_form[:category].name} required class="admin-input">
              <option value="">Select a category</option>
              <option
                :for={{label, slug} <- LumenViae.Rosary.Categories.options()}
                value={slug}
                selected={@edit_form[:category].value == slug}
              >
                {label}
              </option>
            </select>
          </.field>

          <.field
            label="Order"
            required
            hint="Position within the category. Rosary 1-5, Seven Sorrows 1-7."
            errors={@edit_form[:order].errors}
          >
            <input
              type="number"
              name={@edit_form[:order].name}
              value={@edit_form[:order].value || ""}
              required
              min="1"
              max="7"
              class="admin-input"
            />
          </.field>
        </div>

        <.field label="Description" errors={@edit_form[:description].errors}>
          <textarea
            name={@edit_form[:description].name}
            rows="3"
            class="admin-textarea"
            placeholder="e.g. The angel Gabriel announces to Mary that she is to be the Mother of God."
          ><%= @edit_form[:description].value || "" %></textarea>
        </.field>

        <div class="grid md:grid-cols-2 gap-4">
          <.field
            label="Scripture reference"
            errors={@edit_form[:scripture_reference].errors}
          >
            <input
              type="text"
              name={@edit_form[:scripture_reference].name}
              value={@edit_form[:scripture_reference].value || ""}
              class="admin-input"
              placeholder="e.g. Luke 1:26-38"
            />
          </.field>

          <.field
            label="Days prayed"
            hint="The traditional days for this mystery."
            errors={@edit_form[:days_prayed].errors}
          >
            <input
              type="text"
              name={@edit_form[:days_prayed].name}
              value={@edit_form[:days_prayed].value || ""}
              class="admin-input"
              placeholder="e.g. Mondays, Thursdays, and Saturdays"
            />
          </.field>
        </div>
      </div>

      <.form_actions cancel_to={@return_to} cancel_label="Back">
        <button type="submit" class="admin-btn admin-btn-primary">Save changes</button>
      </.form_actions>
    </.panel>
  </.form>
</.admin_page>

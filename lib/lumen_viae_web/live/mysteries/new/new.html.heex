<.admin_page
  active="mysteries"
  title="New mystery"
  subtitle="Mysteries are the fixed frame meditations attach to; you will rarely add one."
  flash={@flash}
  max_width="max-w-3xl"
>
  <.form for={@mystery_form} phx-submit="create_mystery">
    <.panel>
      <div class="space-y-4">
        <.field label="Name" required>
          <input
            type="text"
            name="name"
            required
            class="admin-input"
            placeholder="e.g. The Annunciation"
          />
        </.field>

        <div class="grid md:grid-cols-2 gap-4">
          <.field label="Category" required>
            <select name="category" required class="admin-input">
              <option value="">Select a category</option>
              <option :for={{label, slug} <- LumenViae.Rosary.Categories.options()} value={slug}>
                {label}
              </option>
            </select>
          </.field>

          <.field
            label="Order"
            required
            hint="Position within the category. Rosary 1-5, Seven Sorrows 1-7."
          >
            <input type="number" name="order" required min="1" max="7" class="admin-input" />
          </.field>
        </div>

        <.field label="Description">
          <textarea
            name="description"
            rows="3"
            class="admin-textarea"
            placeholder="e.g. The angel Gabriel announces to Mary that she is to be the Mother of God."
          ></textarea>
        </.field>

        <div class="grid md:grid-cols-2 gap-4">
          <.field label="Scripture reference">
            <input
              type="text"
              name="scripture_reference"
              class="admin-input"
              placeholder="e.g. Luke 1:26-38"
            />
          </.field>

          <.field label="Days prayed" hint="The traditional days for this mystery.">
            <input
              type="text"
              name="days_prayed"
              class="admin-input"
              placeholder="e.g. Mondays, Thursdays, and Saturdays"
            />
          </.field>
        </div>
      </div>

      <.form_actions cancel_to="/admin/mysteries">
        <button type="submit" class="admin-btn admin-btn-primary">Create mystery</button>
      </.form_actions>
    </.panel>
  </.form>
</.admin_page>

<.admin_page
  active="mysteries"
  title="New mystery"
  subtitle="Mysteries are the fixed frame meditations attach to; you will rarely add one."
  flash={@flash}
  max_width="max-w-3xl"
>
  <.form for={@mystery_form} phx-submit="create_mystery">
    <.panel>
      <div class="space-y-4">
        <.field label="Name" required errors={@mystery_form[:name].errors}>
          <input
            type="text"
            name={@mystery_form[:name].name}
            value={@mystery_form[:name].value || ""}
            required
            class="admin-input"
            placeholder="e.g. The Annunciation"
          />
        </.field>

        <div class="grid md:grid-cols-2 gap-4">
          <.field label="Category" required errors={@mystery_form[:category].errors}>
            <select name={@mystery_form[:category].name} required class="admin-input">
              <option value="">Select a category</option>
              <option
                :for={{label, slug} <- LumenViae.Rosary.Categories.options()}
                value={slug}
                selected={@mystery_form[:category].value == slug}
              >
                {label}
              </option>
            </select>
          </.field>

          <.field
            label="Order"
            required
            hint="Position within the category. Rosary 1-5, Seven Sorrows 1-7."
            errors={@mystery_form[:order].errors}
          >
            <input
              type="number"
              name={@mystery_form[:order].name}
              value={@mystery_form[:order].value || ""}
              required
              min="1"
              max="7"
              class="admin-input"
            />
          </.field>
        </div>

        <.field label="Description" errors={@mystery_form[:description].errors}>
          <textarea
            name={@mystery_form[:description].name}
            rows="3"
            class="admin-textarea"
            placeholder="e.g. The angel Gabriel announces to Mary that she is to be the Mother of God."
          ><%= @mystery_form[:description].value || "" %></textarea>
        </.field>

        <div class="grid md:grid-cols-2 gap-4">
          <.field
            label="Scripture reference"
            errors={@mystery_form[:scripture_reference].errors}
          >
            <input
              type="text"
              name={@mystery_form[:scripture_reference].name}
              value={@mystery_form[:scripture_reference].value || ""}
              class="admin-input"
              placeholder="e.g. Luke 1:26-38"
            />
          </.field>

          <.field
            label="Days prayed"
            hint="The traditional days for this mystery."
            errors={@mystery_form[:days_prayed].errors}
          >
            <input
              type="text"
              name={@mystery_form[:days_prayed].name}
              value={@mystery_form[:days_prayed].value || ""}
              class="admin-input"
              placeholder="e.g. Mondays and Thursdays, and Sundays of Advent"
            />
          </.field>
        </div>

        <.field
          label="Fruit"
          hint="The grace the mystery is prayed for, as the app names it."
          errors={@mystery_form[:fruit].errors}
        >
          <input
            type="text"
            name={@mystery_form[:fruit].name}
            value={@mystery_form[:fruit].value || ""}
            class="admin-input"
            placeholder="e.g. Humility"
          />
        </.field>

        <div class="grid md:grid-cols-[2fr_1fr] gap-4">
          <.field
            label="Key verse"
            hint="The one verse to carry into the decade, Douay-Rheims, without its citation."
            errors={@mystery_form[:key_verse].errors}
          >
            <textarea
              name={@mystery_form[:key_verse].name}
              rows="2"
              class="admin-textarea"
              placeholder="e.g. Blessed art thou among women, and blessed is the fruit of thy womb."
            ><%= @mystery_form[:key_verse].value || "" %></textarea>
          </.field>

          <.field
            label="Key verse reference"
            errors={@mystery_form[:key_verse_reference].errors}
          >
            <input
              type="text"
              name={@mystery_form[:key_verse_reference].name}
              value={@mystery_form[:key_verse_reference].value || ""}
              class="admin-input"
              placeholder="e.g. Luke 1:42"
            />
          </.field>
        </div>
      </div>

      <.form_actions cancel_to="/admin/mysteries">
        <button type="submit" class="admin-btn admin-btn-primary">Create mystery</button>
      </.form_actions>
    </.panel>
  </.form>
</.admin_page>

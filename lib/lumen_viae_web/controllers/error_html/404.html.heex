<.error_page
  :if={removed(assigns) == :novena}
  status={404}
  title="Page Not Found"
  current_path={request_path(assigns)}
>
  <p>This novena is no longer on Lumen Viae.</p>
  <:actions>
    <.gold_cta href="/prayers/topics/novenas">See the novenas</.gold_cta>
  </:actions>
</.error_page>
<.error_page
  :if={removed(assigns) != :novena}
  status={404}
  title="Page Not Found"
  current_path={request_path(assigns)}
>
  <p>
    There is nothing at this address. The page may have moved, or the link
    may have a typing error in it.
  </p>
  <p class="mt-4 italic text-ink-muted">Seek, and you shall find. - Matthew 7:7</p>
</.error_page>

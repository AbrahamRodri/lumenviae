<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Lumen Viae">
      {assigns[:page_title] || "Meditations on the Holy Rosary"}
    </.live_title>
    <% meta_description =
      assigns[:meta_description] ||
        "Pray the traditional fifteen mysteries of the Holy Rosary with meditations from the saints and doctors of the Church. Guided audio, scripture, and the methods of St. Louis de Montfort." %>
    <meta name="description" content={meta_description} />
    <link rel="canonical" href={"https://www.lumenviae.org#{@conn.request_path}"} />
    <meta property="og:site_name" content="Lumen Viae" />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content={assigns[:page_title] || "Lumen Viae - Meditations on the Holy Rosary"}
    />
    <meta property="og:description" content={meta_description} />
    <meta property="og:url" content={"https://www.lumenviae.org#{@conn.request_path}"} />
    <meta
      property="og:image"
      content="https://www.lumenviae.org/images/pngs/our-lady-of-sorrows-horizontal.jpg"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content={assigns[:page_title] || "Lumen Viae - Meditations on the Holy Rosary"}
    />
    <meta name="twitter:description" content={meta_description} />
    <meta
      name="twitter:image"
      content="https://www.lumenviae.org/images/pngs/our-lady-of-sorrows-horizontal.jpg"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Ovo&family=Work+Sans:wght@400;500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Cinzel:wght@400;600;700&family=Cinzel+Decorative:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-parchment">
    <%!-- Lancet-arch clip path for <.arch_frame>, in objectBoundingBox units so
          it scales with any element. Straight sides sweep into a pointed apex,
          mirroring the app's GothicArchShape. --%>
    <svg width="0" height="0" aria-hidden="true" style="position:absolute">
      <defs>
        <clipPath id="lancet-arch" clipPathUnits="objectBoundingBox">
          <path d="M 0 1 L 0 0.28 Q 0.03 0.106 0.5 0 Q 0.97 0.106 1 0.28 L 1 1 Z" />
        </clipPath>
      </defs>
    </svg>
    <LumenViaeWeb.Components.Nav.header is_admin={assigns[:is_admin] || false} />

    {@inner_content}

    <LumenViaeWeb.Components.Footer.footer />
  </body>
</html>

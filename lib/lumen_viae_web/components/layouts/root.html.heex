<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <%!-- The header's night, so the browser chrome on a phone runs into it. --%>
    <meta name="theme-color" content="#070E1F" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Lumen Viae" suffix=" | Lumen Viae">
      {assigns[:page_title] || "Meditations on the Holy Rosary"}
    </.live_title>
    <%!-- Description, canonical link, link previews and structured data: what a
          page put in LumenViaeWeb.PageMeta, or the site's defaults. --%>
    <LumenViaeWeb.Components.MetaTags.meta_tags
      meta={assigns[:meta]}
      page_title={assigns[:page_title]}
      description={assigns[:meta_description]}
      request_path={@conn.request_path}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href={~p"/favicon.ico"} sizes="32x32" />
    <link rel="icon" href={~p"/favicon.svg"} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <%!-- LiveDebugger's browser hooks. Set only in development; nil, and so
          nothing, everywhere else. See docs/DEV_TOOLS.md. --%>
    {Application.get_env(:live_debugger, :live_debugger_tags)}
  </head>
  <body class="site bg-night text-ink-light">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <%!-- Lancet-arch clip path for <.arch_frame>, in objectBoundingBox units so
          it scales with any element. Straight sides sweep into a pointed apex,
          mirroring the app's GothicArchShape. --%>
    <svg width="0" height="0" aria-hidden="true" style="position:absolute">
      <defs>
        <clipPath id="lancet-arch" clipPathUnits="objectBoundingBox">
          <path d="M 0 1 L 0 0.28 Q 0.03 0.106 0.5 0 Q 0.97 0.106 1 0.28 L 1 1 Z" />
        </clipPath>
      </defs>
    </svg>
    <LumenViaeWeb.Components.Nav.header
      is_admin={assigns[:is_admin] || false}
      current_path={@conn.request_path}
    />

    <%!-- The page's one <main>. A page template must not render another;
          tabindex lets the skip link move focus here in every browser. --%>
    <main id="main-content" tabindex="-1" class="site-main">
      {@inner_content}
    </main>

    <LumenViaeWeb.Components.Footer.footer />
  </body>
</html>

# /srv/<name>/backup.env on the server (mode 600, owner deploy): the R2
# bucket bin/backup writes to and bin/restore-test reads from. Shell syntax,
# names only here; values never go in the repository. Kept apart from the
# app's .env so these keys and the app's never mix.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# One folder per site, so sites can share a bucket: db/lumenviae,
# db/tornadodiet, db/clipperhandz.
BACKUP_PREFIX=db/lumenviae
# Optional: a URL fetched after each good backup (healthchecks.io's free
# plan emails when a night's ping does not arrive).
BACKUP_PING_URL=

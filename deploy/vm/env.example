# The names /srv/lumenviae/.env holds on the VM (mode 600). Names only:
# values never go in the repository. Start from every name in
# `fly secrets list -a lumenviae`; the runbook says where each value comes
# from (reports/rig/hosting-migration.md, "Secrets on the VM").
SECRET_KEY_BASE=
TOKEN_SIGNING_SECRET=
DATABASE_URL=ecto://lumen_viae:<POSTGRES_PASSWORD>@db/lumen_viae
POSTGRES_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_S3_BUCKET=lumenviae-audio
ADMIN_PASSWORD=
OPS_STATUS_TOKEN=
CLOUDFLARE_API_TOKEN=
# The secret the Fly pass-through sends beside its caller's address
# (deploy/fly-proxy/README.md); the same value as the Fly secret of lumenviae.
FLY_PROXY_SECRET=
# Left out on purpose: ELEVEN_LABS_API_KEY. The restored jobs table would
# send any pending narration to ElevenLabs from here; without the key a
# narration job cancels before any call. Abraham adds it when narration is
# next wanted.
# Also left out: ECTO_IPV6 and DNS_CLUSTER_QUERY, even if Fly holds them.
# ECTO_IPV6 would make the app look for db over IPv6 only, which Docker's
# network does not offer; DNS_CLUSTER_QUERY asks Fly's private DNS.
# Copy any of these that are set on Fly:
# GEOLOCATION_ENABLED= GEOLOCATION_PROVIDER= PUBLIC_ASSET_BASE_URL=
# AUDIO_URL_TTL_SECONDS= ELEVENLABS_CONCURRENCY=

# The nightly backup of the stack in /srv/<name> (deploy/vm/bin/backup).
# Installed once: docs/HOSTING_RECIPE.md, "Turn on the backups".
[Unit]
Description=Back up the database of /srv/%i to R2
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/srv/%i
ExecStart=/srv/%i/bin/backup

# The Fly pass-through: stock Caddy and one Caddyfile (README.md).
# Pinned to one release and its multi-arch digest, so a rebuild months from
# now runs the same Caddy; raise both together to upgrade.
FROM caddy:2.10.2@sha256:c3d7ee5d2b11f9dc54f947f68a734c84e9c9666c92c88a7f30b9cba5da182adb
COPY Caddyfile /etc/caddy/Caddyfile
EXPOSE 8080

<div class="bg-parchment min-h-screen">
  <!-- Handbook hero: split title spread, light like the open page of a manual -->
  <section class="relative border-b-3 border-gold bg-gradient-to-b from-cream-dark/60 to-parchment">
    <div class="max-w-6xl mx-auto px-6 md:px-10 pt-12 pb-10 md:pt-16 md:pb-14">
      <div class="grid md:grid-cols-[1fr_auto] gap-10 md:gap-16 items-center">
        <div class="text-center md:text-left">
          <p class="font-cinzel text-xs md:text-sm tracking-[0.35em] uppercase text-gold-dark mb-4 animate-rise">
            A Practical Manual
          </p>

          <h1
            class="font-cinzel uppercase text-3xl md:text-5xl tracking-[0.06em] text-navy animate-rise"
            style="animation-delay: 120ms"
          >
            How to Pray <br />the Rosary
          </h1>

          <.sacred_divider class="max-w-[240px] mx-auto md:mx-0" />

          <p
            class="font-garamond text-xl md:text-2xl text-brown italic max-w-xl leading-relaxed mb-8 animate-rise"
            style="animation-delay: 240ms"
          >
            Every prayer, every bead, every step&mdash;and the methods of
            St. Louis de Montfort that draw upon the soul the grace of the
            mysteries of the Life, Passion, and Glory of Jesus and Mary.
          </p>

          <div
            class="flex flex-wrap justify-center md:justify-start gap-x-8 gap-y-2 font-garamond text-base text-brown animate-rise"
            style="animation-delay: 320ms"
          >
            <span><span class="font-cinzel text-gold-dark">10</span> steps to learn</span>
            <span><span class="font-cinzel text-gold-dark">5</span> methods of de Montfort</span>
            <span><span class="font-cinzel text-gold-dark">15</span> promises of Our Lady</span>
          </div>
        </div>

        <figure class="mx-auto w-64 md:w-80 shrink-0 animate-rise" style="animation-delay: 200ms">
          <div class="bg-white border border-gold/30 rounded-sm shadow-soft p-3 md:p-4">
            <img
              src="/images/woodcuts/madonna-crescent-crop.jpg"
              alt="The Madonna on the Crescent, woodcut by Albrecht Durer"
              class="w-full h-auto woodcut-blend"
            />
          </div>
          <figcaption class="font-garamond italic text-brown text-sm text-center mt-3">
            Albrecht Durer, The Madonna on the Crescent, <br />
            frontispiece to The Life of the Virgin, 1511
          </figcaption>
        </figure>
      </div>
    </div>
  </section>
  
<!-- Manual body: sticky contents rail beside the chapters -->
  <div class="container-boxed py-12 md:py-16">
    <div class="lg:grid lg:grid-cols-[15rem_1fr] lg:gap-12 max-w-6xl mx-auto">
      <!-- Contents rail -->
      <nav aria-label="Contents" class="mb-10 lg:mb-0">
        <div class="lg:sticky lg:top-8 border-l border-gold/40 pl-5">
          <p class="font-cinzel text-gold-dark text-xs tracking-[0.3em] uppercase mb-4">
            Contents
          </p>
          <ol class="space-y-2.5 font-garamond text-base">
            <li>
              <a
                href="#how-to-pray"
                class="group flex gap-3 text-brown hover:text-navy transition-colors"
              >
                <span class="font-cinzel text-gold-dark w-4 shrink-0">1</span>
                <span class="group-hover:underline decoration-gold/60 underline-offset-4">
                  Step by Step
                </span>
              </a>
            </li>
            <li>
              <a
                href="#method-i"
                class="group flex gap-3 text-brown hover:text-navy transition-colors"
              >
                <span class="font-cinzel text-gold-dark w-4 shrink-0">2</span>
                <span class="group-hover:underline decoration-gold/60 underline-offset-4">
                  Method I: The Offering
                </span>
              </a>
            </li>
            <li>
              <a
                href="#method-ii"
                class="group flex gap-3 text-brown hover:text-navy transition-colors"
              >
                <span class="font-cinzel text-gold-dark w-4 shrink-0">3</span>
                <span class="group-hover:underline decoration-gold/60 underline-offset-4">
                  Method II: The Living Hail Mary
                </span>
              </a>
            </li>
            <li>
              <a
                href="#other-methods"
                class="group flex gap-3 text-brown hover:text-navy transition-colors"
              >
                <span class="font-cinzel text-gold-dark w-4 shrink-0">4</span>
                <span class="group-hover:underline decoration-gold/60 underline-offset-4">
                  Methods III&ndash;V
                </span>
              </a>
            </li>
            <li>
              <a
                href="#promises"
                class="group flex gap-3 text-brown hover:text-navy transition-colors"
              >
                <span class="font-cinzel text-gold-dark w-4 shrink-0">5</span>
                <span class="group-hover:underline decoration-gold/60 underline-offset-4">
                  The Fifteen Promises
                </span>
              </a>
            </li>
          </ol>

          <div class="mt-6">
            <.link
              navigate="/dashboard"
              class="font-cinzel text-[0.7rem] tracking-[0.15em] uppercase text-gold-dark hover:text-gold transition-colors"
            >
              Ready? Pray today's mysteries &rarr;
            </.link>
          </div>
        </div>
      </nav>
      
<!-- Chapters -->
      <div class="min-w-0">
        <.how_to_pray steps={@steps} selected_step={@selected_step} loop_beads={@loop_beads} />

        <div class="mb-12 max-w-3xl">
          <div class="flex items-center gap-3 mb-3">
            <span class="h-px w-10 bg-gold/40 shrink-0" aria-hidden="true"></span>
            <p class="font-cinzel text-xs tracking-[0.3em] uppercase text-gold-dark">
              Going Deeper
            </p>
            <span class="h-px bg-gold/40 grow" aria-hidden="true"></span>
          </div>
          <h2 class="font-cinzel text-navy text-3xl md:text-4xl mb-5">
            The Methods of St. Louis de Montfort
          </h2>
          <p class="font-garamond text-brown text-lg md:text-xl leading-relaxed">
            From <em>The Secret of the Rosary</em>
            and his <em>Methods for Saying the
            Rosary</em>, St. Louis de Montfort left five ways of praying the beads,
            each designed to draw upon the soul the grace of the mysteries.
          </p>
        </div>

        <.method_one method_one={@method_one} method_set={@method_set} />

        <.method_two />

        <.other_methods />

        <.promises promises={@promises} />
        
<!-- Closing -->
        <div class="text-center mt-16">
          <.sacred_divider class="max-w-[210px] mx-auto" />

          <p class="font-garamond text-navy text-xl italic mb-8">
            Ad Majorem Dei Gloriam
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <.gold_cta navigate="/dashboard">
              Pray Today's Mysteries
            </.gold_cta>
            <.link navigate="/true-devotion" class="btn-outline-gold text-navy">
              Discover True Devotion to Mary
            </.link>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

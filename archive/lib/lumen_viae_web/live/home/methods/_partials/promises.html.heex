<section id="promises" class="mb-16 scroll-mt-8">
  <div class="relative bg-white rounded-2xl shadow-soft overflow-hidden border border-gold/30">
    <div class="relative p-8 md:p-12">
      <div class="text-center mb-10">
        <p class="font-cinzel text-xs tracking-[0.35em] uppercase text-gold-dark mb-3">
          Handed Down by Tradition
        </p>
        <h2 class="font-cinzel text-navy text-4xl md:text-5xl">
          The Fifteen Promises of the Rosary
        </h2>
        <.sacred_divider class="max-w-[210px] mx-auto" />
        <p class="font-garamond text-brown text-lg md:text-xl max-w-2xl mx-auto leading-relaxed">
          According to a tradition cherished by the Church, Our Lady made these
          fifteen promises to those devoted to her Rosary, given through
          St. Dominic and Blessed Alan de la Roche.
        </p>
      </div>

      <ol class="grid md:grid-cols-2 gap-x-10 max-w-4xl mx-auto">
        <%= for {promise, index} <- Enum.with_index(@promises, 1) do %>
          <li class="flex items-baseline gap-4 py-3.5 border-b border-gold/15">
            <span class="font-cinzel text-gold-dark text-xl w-8 shrink-0 text-right">
              {index}.
            </span>
            <span class="font-garamond text-brown text-lg leading-relaxed">{promise}</span>
          </li>
        <% end %>
      </ol>
    </div>
  </div>
</section>
